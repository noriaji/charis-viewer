}
.lm .lm-list
{
    flex: none;
    height: 120dp;
    margin-top: 2dp;
}
.lm .lm-row
{
    flex: none;
    display: flex;
    flex-direction: row;
}
.lm .lm-buttons
{
    height: 22dp;
    margin-top: 6dp;
}
.lm button.inline
{
