}
.lm .lm-target
{
    height: 30dp;
    margin-top: 2dp;
    white-space: normal;
}
.lm .lm-meshrow
{
    height: 22dp;
    margin-top: 3dp;
}
.lm .lm-meshes-label
{
    width: 60dp;
    margin: 3dp 0 0 2dp;
}
.lm select.lm-meshes
{
    flex: 1;
    height: 22dp;
    line-height: 20dp;
    margin: 0 2dp 0 4dp;
}
