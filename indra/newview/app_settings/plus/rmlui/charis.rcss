    margin-top: 6dp;
}
.lm .lm-logl
{
    margin-top: 10dp;
}
.lm .lm-log
{
    flex: 1;
    min-height: 36dp;
    margin-top: 2dp;
}
.lm .lm-log textarea.ps-readonly
{
    width: 100%;
    height: 100%;
    caret-color: transparent;
}
