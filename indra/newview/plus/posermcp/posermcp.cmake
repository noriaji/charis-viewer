# -*- cmake -*-
# Poser MCP: a local MCP endpoint (loopback only, off by default) that lets an
# AI assistant drive the Poser (plus/poser). Included by plus/plus.cmake.
# mcphttpserver.*, posehistory.* and the solvers (*solver*, posenudge.*) have no
# viewer dependencies (tested standalone, see tools/poser-mcp in the sl-viewer
# repository). posesolvertables.h is generated by tools/poser-mcp/gen_solver_tables.py.

list(APPEND plus_SOURCE_FILES
    plus/posermcp/aimsolver.cpp
    plus/posermcp/contactsolver.cpp
    plus/posermcp/debugtools.cpp
    plus/posermcp/mcphttpserver.cpp
    plus/posermcp/posehistory.cpp
    plus/posermcp/posehistorytools.cpp
    plus/posermcp/posenudge.cpp
    plus/posermcp/posermcp.cpp
    plus/posermcp/posertools.cpp
    plus/posermcp/posertools_aim.cpp
    plus/posermcp/posertools_contact.cpp
    plus/posermcp/posertools_snapshot.cpp
    plus/posermcp/posesolver.cpp
    plus/posermcp/posesolverjson.cpp
    plus/posermcp/posesolverlive.cpp
    plus/posermcp/posesolvetools.cpp
    plus/posermcp/reachsolver.cpp
    plus/posermcp/settingstools.cpp
    )

