# -*- cmake -*-
# Motion Between Poses (research/324 in the sl-viewer repository): the poser
# makes a short motion between two poses with a local model in a helper
# process. Picked up by plus/plus.cmake (its glob of plus/*/*.cmake).
# somaretarget.* and motionclip.* have no viewer dependencies besides llmath
# (tested standalone by somaretarget_test.cpp, not built here); so have motionbvh.*,
# motiontracks.*, motionplayback.* and motiontimeline.* (motionui_test.cpp / motiontimeline_test.cpp, not built here); so has motiontimelinegeom.h (motiontimelineview_test.cpp). somatables.h is
# generated by tools/motionbricks-eval/gen_somatables.py.

list(APPEND plus_SOURCE_FILES
    plus/posermotion/motionbvh.cpp
