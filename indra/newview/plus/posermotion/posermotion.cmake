    plus/posermotion/motionfloater_play.cpp
    plus/posermotion/motionfloater_save.cpp
    plus/posermotion/motionfloater_view.cpp
    plus/posermotion/motionmodel.cpp
    plus/posermotion/motionplayback.cpp
    plus/posermotion/motiontimeline.cpp
    plus/posermotion/motiontimelineview.cpp
    plus/posermotion/motiontracks.cpp
    plus/posermotion/posermotion.cpp
    plus/posermotion/restskeleton.cpp
    plus/posermotion/somaretarget.cpp
    )

