<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_voice.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="voice_panel">
    <plus_ps_box name="ps_ground">
        <scroll_container name="voice_scroll">
            <panel name="voice_scroll_panel">
                <plus_ps_slider_compat name="Voice Volume" label="Stemme chat" />
                <plus_ps_check_compat name="enable_voice_check" label="Aktiveret" />
                <plus_ps_text name="Listen from">
                    Hør stemmer fra:
                </plus_ps_text>
                <plus_ps_check_compat name="enable_lip_sync" label="Bevæg avatar-læber når der snakkes" />
                <plus_ps_check_compat name="push_to_talk_toggle_check" label="Skift tale tænd/sluk når jeg trykker" tool_tip="Når du er i skift-modus, vil hvert tryk tænde eller slukke din mikrofon. Når du ikke er i skift-modus, vil din mikrofon kun være tændt når knappen/tasten holdes nede (som en Walkie Talkie)" />
                <plus_ps_button_compat name="device_settings_btn" label="Input/Output enheder" />
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
