<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The Charis window (research/267 gfxadv-ui) in this language: the words of floater_preferences_graphics_advanced.xml, by name (the chain of names of en). -->
<floater name="prefs_graphics_advanced" title="ERWEITERTE GRAFIKEINSTELLUNGEN">
	<plus_ps_tabs name="graphics_tabs">
		<panel label="Allgemein" name="General">
			<scroll_container name="general_scroll">
				<panel name="general_scroll_panel">
					<plus_ps_text name="ShadersText">
						Shader
					</plus_ps_text>
					<plus_ps_check_compat initial_value="true" label="Transparentes Wasser" name="TransparentWater"/>
					<plus_ps_check_compat initial_value="true" label="Ambient Occlusion" name="UseSSAO"/>
					<plus_ps_text name="RenderShadowDetailText">
						Schatten:
					</plus_ps_text>
					<plus_ps_combo name="ShadowDetail">
						<plus_ps_combo.item label="Keine" name="0"/>
						<plus_ps_combo.item label="Sonne/Mond" name="1"/>
						<plus_ps_combo.item label="Sonne/Mond + Projektoren" name="2"/>
					</plus_ps_combo>
					<plus_ps_slider_compat label="Sichtweite:" name="DrawDistance"/>
					<plus_ps_text name="DrawDistanceMeterText2">
						m
					</plus_ps_text>
					<plus_ps_slider_compat label="Max. Partikelzahl:" name="MaxParticleCount"/>
					<plus_ps_text name="AvatarText">
						Avatar
					</plus_ps_text>
					<plus_ps_slider_compat label="Maximale Komplexität:" name="IndirectMaxComplexity" tool_tip="Bestimmt, an welchem Punkt ein visuell komplexer Avatar als JellyDoll dargestellt wird"/>
					<plus_ps_text name="IndirectMaxComplexityText">
						0
					</plus_ps_text>
					<plus_ps_slider_compat label="Max. Anzahl an voll dargestellten Avataren:" name="IndirectMaxNonImpostors"/>
					<plus_ps_text name="IndirectMaxNonImpostorsText">
						0
					</plus_ps_text>
					<plus_ps_slider_compat label="Physik:" name="AvatarPhysicsDetail"/>
					<plus_ps_text name="AvatarPhysicsDetailText">
						Niedrig
					</plus_ps_text>
					<plus_ps_text name="MeshText">
						Darstellungsgrad
					</plus_ps_text>
					<plus_ps_slider_compat label="Objekte:" name="ObjectMeshDetail"/>
					<plus_ps_text name="ObjectMeshDetailText">
						Niedrig
					</plus_ps_text>
					<plus_ps_slider_compat label="Flexiprimitiva:" name="FlexibleMeshDetail"/>
					<plus_ps_text name="FlexibleMeshDetailText">
						Niedrig
					</plus_ps_text>
					<plus_ps_slider_compat label="Bäume:" name="TreeMeshDetail"/>
					<plus_ps_text name="TreeMeshDetailText">
						Niedrig
					</plus_ps_text>
					<plus_ps_slider_compat label="Avatare:" name="AvatarMeshDetail"/>
					<plus_ps_text name="AvatarMeshDetailText">
						Niedrig
					</plus_ps_text>
					<plus_ps_slider_compat label="Terrain:" name="TerrainMeshDetail"/>
					<plus_ps_text name="TerrainMeshDetailText">
						Niedrig
					</plus_ps_text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Hardware" name="Hardware Settings">
			<scroll_container name="hardware_scroll">
				<panel name="hardware_scroll_panel">
					<plus_ps_check_compat initial_value="true" label="Texturkomprimierung aktivieren (Neustart erforderlich)" name="texture compression" tool_tip="Komprimiert Texturen im Videospeicher, damit höher auflösende Texturen geladen werden können (leichte Beeinträchtigung der Farbqualität)."/>
					<plus_ps_text name="antialiasing label">
						Antialiasing:
					</plus_ps_text>
					<plus_ps_combo label="Antialiasing" name="fsaa">
						<plus_ps_combo.item label="Deaktiviert" name="FSAADisabled"/>
					</plus_ps_combo>
					<plus_ps_text name="antialiasing restart">
						(Neustart erforderlich)
					</plus_ps_text>
					<plus_ps_check_compat initial_value="true" label="Unterstützung für HiDPI-Displays aktivieren (Neustart erforderlich)" name="use HiDPI" tool_tip="OpenGL für hochauflösende Darstellung aktivieren."/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Darstellung" name="Rendering">
			<scroll_container name="rendering_scroll">
				<panel name="rendering_scroll_panel">
					<plus_ps_text name="Texture Rendering">
						Textur-Darstellung
					</plus_ps_text>
					<plus_ps_text name="Miscellaneous Rendering">
						Sonstige Darstellungsoptionen
					</plus_ps_text>
					<plus_ps_slider_compat label="Post-Processing-Qualität:" name="RenderPostProcess"/>
					<plus_ps_text name="PostProcessText">
						Niedrig
					</plus_ps_text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Schärfentiefe" name="DOF panel">
			<scroll_container name="dof_scroll">
				<panel name="dof_scroll_panel">
					<plus_ps_check_compat initial_value="true" label="Schärfentiefe aktivieren (Bereiche außerhalb des Kamerafokus erscheinen unscharf)" name="UseDoF"/>
					<plus_ps_check_compat name="RenderDepthOfFieldInEditMode" label="Im Editier-Modus aktivieren"/>
					<plus_ps_slider_compat name="CameraFNum" label="Kamera-Blendenzahl (k-Wert):" tool_tip="Kamera-Blendenzahl (k-Wert) für die Schärfentiefe"/>
					<plus_ps_slider_compat name="CameraFocal" label="Kamera-Brennweite in mm:" tool_tip="Kamera-Brennweite für die Schärfentiefe (in Millimeter)"/>
					<plus_ps_slider_compat name="Camera FOV" label="Kamera-Sichtfeld (Grad):" tool_tip="Vertikales Kamera-Sichtfeld für die Schärfentiefe (in Grad)"/>
					<plus_ps_slider_compat name="CameraFocusTrans" label="Fokus-Übergangszeit:" tool_tip="Zeit, die benötigt wird, um den Focus neu einzustellen"/>
					<plus_ps_slider_compat name="CameraDoFResScale" label="Schärfentiefe-Darstellungsqualität:" tool_tip="Beeinflusst die Qualität der Unschärfe und Geschwindigkeit der Darstellung (höher = bessere Qualität, niedriger = höhere Geschwindigkeit"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Charis" name="Charis panel">
			<scroll_container name="charis_scroll">
				<panel name="charis_scroll_panel">
				</panel>
			</scroll_container>
		</panel>
	</plus_ps_tabs>
	<plus_ps_button_compat label="Auf empfohlene Einstellungen zurücksetzen" name="Defaults" width="400"/>
	<plus_ps_button_compat label="OK" label_selected="OK" name="OK"/>
	<plus_ps_button_compat label="Abbrechen" label_selected="Abbrechen" name="Cancel"/>
	<check_box label="RenderAvatarMaxComplexity" name="RenderAvatarMaxComplexity"/>
	<check_box label="RenderAvatarMaxNonImpostors" name="RenderAvatarMaxNonImpostors"/>
</floater>
