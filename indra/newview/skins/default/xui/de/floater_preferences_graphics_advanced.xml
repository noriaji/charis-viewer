<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="prefs_graphics_advanced" title="ERWEITERTE GRAFIKEINSTELLUNGEN">
	<!-- plus: gfx-tabs (research/238). The rows sit in the tabs of en, wrapped the same way
	     (tab_container / panel / scroll_container / panel), or the translation does not apply. -->
	<tab_container name="graphics_tabs">
		<panel label="Allgemein" name="General">
			<scroll_container name="general_scroll">
				<panel name="general_scroll_panel">
					<text name="ShadersText">
						Shader
					</text>
					<check_box initial_value="true" label="Transparentes Wasser" name="TransparentWater"/>
					<check_box initial_value="true" label="Ambient Occlusion" name="UseSSAO"/>
					<text name="RenderShadowDetailText">
						Schatten:
					</text>
					<combo_box name="ShadowDetail">
						<combo_box.item label="Keine" name="0"/>
						<combo_box.item label="Sonne/Mond" name="1"/>
						<combo_box.item label="Sonne/Mond + Projektoren" name="2"/>
					</combo_box>
					<slider label="Sichtweite:" name="DrawDistance"/>
					<text name="DrawDistanceMeterText2">
						m
					</text>
					<slider label="Max. Partikelzahl:" name="MaxParticleCount"/>
					<text name="AvatarText">
						Avatar
					</text>
					<slider label="Maximale Komplexität:" name="IndirectMaxComplexity" tool_tip="Bestimmt, an welchem Punkt ein visuell komplexer Avatar als JellyDoll dargestellt wird"/>
					<text name="IndirectMaxComplexityText">
						0
					</text>
					<slider label="Max. Anzahl an voll dargestellten Avataren:" name="IndirectMaxNonImpostors"/>
					<text name="IndirectMaxNonImpostorsText">
						0
					</text>
					<slider label="Physik:" name="AvatarPhysicsDetail"/>
					<text name="AvatarPhysicsDetailText">
						Niedrig
					</text>
					<text name="MeshText">
						Darstellungsgrad
					</text>
					<slider label="Objekte:" name="ObjectMeshDetail"/>
					<text name="ObjectMeshDetailText">
						Niedrig
					</text>
					<slider label="Flexiprimitiva:" name="FlexibleMeshDetail"/>
					<text name="FlexibleMeshDetailText">
						Niedrig
					</text>
					<slider label="Bäume:" name="TreeMeshDetail"/>
					<text name="TreeMeshDetailText">
						Niedrig
					</text>
					<slider label="Avatare:" name="AvatarMeshDetail"/>
					<text name="AvatarMeshDetailText">
						Niedrig
					</text>
					<slider label="Terrain:" name="TerrainMeshDetail"/>
					<text name="TerrainMeshDetailText">
						Niedrig
					</text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Hardware" name="Hardware Settings">
			<scroll_container name="hardware_scroll">
				<panel name="hardware_scroll_panel">
					<check_box initial_value="true" label="Texturkomprimierung aktivieren (Neustart erforderlich)" name="texture compression" tool_tip="Komprimiert Texturen im Videospeicher, damit höher auflösende Texturen geladen werden können (leichte Beeinträchtigung der Farbqualität)."/>
					<text name="antialiasing label">
						Antialiasing:
					</text>
					<combo_box label="Antialiasing" name="fsaa">
						<combo_box.item label="Deaktiviert" name="FSAADisabled"/>
					</combo_box>
					<text name="antialiasing restart">
						(Neustart erforderlich)
					</text>
					<check_box initial_value="true" label="Unterstützung für HiDPI-Displays aktivieren (Neustart erforderlich)" name="use HiDPI" tool_tip="OpenGL für hochauflösende Darstellung aktivieren."/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Darstellung" name="Rendering">
			<scroll_container name="rendering_scroll">
				<panel name="rendering_scroll_panel">
					<text name="Texture Rendering">
						Textur-Darstellung
					</text>
					<text name="Miscellaneous Rendering">
						Sonstige Darstellungsoptionen
					</text>
					<slider label="Post-Processing-Qualität:" name="RenderPostProcess"/>
					<text name="PostProcessText">
						Niedrig
					</text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Schärfentiefe" name="DOF panel">
			<scroll_container name="dof_scroll">
				<panel name="dof_scroll_panel">
					<check_box initial_value="true" label="Schärfentiefe aktivieren (Bereiche außerhalb des Kamerafokus erscheinen unscharf)" name="UseDoF"/>
					<check_box name="RenderDepthOfFieldInEditMode" label="Im Editier-Modus aktivieren"/>
					<slider name="CameraFNum" label="Kamera-Blendenzahl (k-Wert):" tool_tip="Kamera-Blendenzahl (k-Wert) für die Schärfentiefe"/>
					<slider name="CameraFocal" label="Kamera-Brennweite in mm:" tool_tip="Kamera-Brennweite für die Schärfentiefe (in Millimeter)"/>
					<slider name="Camera FOV" label="Kamera-Sichtfeld (Grad):" tool_tip="Vertikales Kamera-Sichtfeld für die Schärfentiefe (in Grad)"/>
					<slider name="CameraFocusTrans" label="Fokus-Übergangszeit:" tool_tip="Zeit, die benötigt wird, um den Focus neu einzustellen"/>
					<slider name="CameraDoFResScale" label="Schärfentiefe-Darstellungsqualität:" tool_tip="Beeinflusst die Qualität der Unschärfe und Geschwindigkeit der Darstellung (höher = bessere Qualität, niedriger = höhere Geschwindigkeit"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Charis" name="Charis panel">
			<scroll_container name="charis_scroll">
				<panel name="charis_scroll_panel">
				</panel>
			</scroll_container>
		</panel>
	</tab_container>
	<!-- /plus -->
	<button label="Auf empfohlene Einstellungen zurücksetzen" name="Defaults"/>
	<button label="OK" label_selected="OK" name="OK"/>
	<button label="Abbrechen" label_selected="Abbrechen" name="Cancel"/>
	<check_box label="RenderAvatarMaxComplexity" name="RenderAvatarMaxComplexity"/>
	<check_box label="RenderAvatarMaxNonImpostors" name="RenderAvatarMaxNonImpostors"/>
</floater>
