<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="chat" label="Text-Chat">
	<plus_ps_box name="ps_ground">
		<scroll_container name="chat_scroll">
			<panel name="chat_scroll_panel">
				<panel name="general_chat_settings">
					<plus_ps_check_compat name="auto_complete_gestures" label="Automatische Gestenvervollständigung beim Chat in der Nähe" />
					<plus_ps_check_compat name="play_typing_animation" label="Beim Chatten Tippanimation abspielen" />
					<plus_ps_check_compat name="bubble_text_chat" label="Blasen-Chat" />
					<plus_ps_text name="font_size">
						Schriftgröße:
					</plus_ps_text>
					<plus_ps_combo name="chat_font_size">
						<plus_ps_combo.item name="Small" label="Klein" />
						<plus_ps_combo.item name="Medium" label="Mittel" />
						<plus_ps_combo.item name="Large" label="Groß" />
					</plus_ps_combo>
				</panel>
				<panel name="im_notification_settings">
					<plus_ps_check_compat name="voice_call_friends_only_check" label="Nur IMs und Anrufe von Freunden oder Gruppen durchstellen" />
					<plus_ps_text name="friend_ims">
						IMs von Freunden:
					</plus_ps_text>
					<plus_ps_combo name="FriendIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Unterhaltungsfenster öffnen" />
						<plus_ps_combo.item name="PopUpMessage" label="Nachricht in Popup anzeigen" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Flash-Symbolleistenschaltfläche" />
						<plus_ps_combo.item name="NoAction" label="Keine Aktion" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_friend_im" label="Sound abspielen" />
					<plus_ps_text name="non_friend_ims">
						IMs von anderen:
					</plus_ps_text>
					<plus_ps_combo name="NonFriendIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Unterhaltungsfenster öffnen" />
						<plus_ps_combo.item name="PopUpMessage" label="Nachricht in Popup anzeigen" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Flash-Symbolleistenschaltfläche" />
						<plus_ps_combo.item name="NoAction" label="Keine Aktion" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_non_friend_im" label="Sound abspielen" />
					<plus_ps_text name="conference_ims">
						Konferenz-IMs:
					</plus_ps_text>
					<plus_ps_combo name="ConferenceIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Unterhaltungsfenster öffnen" />
						<plus_ps_combo.item name="PopUpMessage" label="Nachricht in Popup anzeigen" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Flash-Symbolleistenschaltfläche" />
						<plus_ps_combo.item name="NoAction" label="Keine Aktion" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_conference_im" label="Sound abspielen" />
					<plus_ps_text name="group_chat">
						Gruppen-Chat:
					</plus_ps_text>
					<plus_ps_combo name="GroupChatOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Unterhaltungsfenster öffnen" />
						<plus_ps_combo.item name="PopUpMessage" label="Nachricht in Popup anzeigen" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Flash-Symbolleistenschaltfläche" />
						<plus_ps_combo.item name="NoAction" label="Keine Aktion" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_group_chat_im" label="Sound abspielen" />
					<plus_ps_text name="nearby_chat">
						Chat in der Nähe:
					</plus_ps_text>
					<plus_ps_combo name="NearbyChatOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Unterhaltungsfenster öffnen" />
						<plus_ps_combo.item name="PopUpMessage" label="Nachricht in Popup anzeigen" />
						<plus_ps_combo.item name="FlashToolBarButton" label="Flash-Symbolleistenschaltfläche" />
						<plus_ps_combo.item name="NoAction" label="Keine Aktion" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_nearby_chat_im" label="Sound abspielen" />
					<plus_ps_text name="object_ims">
						IMs von Objekten:
					</plus_ps_text>
					<plus_ps_combo name="ObjectIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Unterhaltungsfenster öffnen" />
						<plus_ps_combo.item name="PopUpMessage" label="Nachricht in Popup anzeigen" />
						<plus_ps_combo.item name="FlashToolBarButton" label="Flash-Symbolleistenschaltfläche" />
						<plus_ps_combo.item name="NoAction" label="Keine Aktion" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_object_im" label="Sound abspielen" />
					<plus_ps_text name="notifications_alert">
						Um vorübergehend alle Benachrichtigungen zu stoppen, wählen Sie „Unterhalten“ &gt; „Nicht stören“.
					</plus_ps_text>
				</panel>
				<panel name="play_sound_settings">
					<plus_ps_text name="play_sound">
						Sound abspielen:
					</plus_ps_text>
					<plus_ps_check_compat name="new_conversation" label="Neue Unterhaltung" />
					<plus_ps_check_compat name="teleport_offer" label="Teleport-Angebot" />
					<plus_ps_check_compat name="incoming_voice_call" label="Eingehender Anruf" />
					<plus_ps_check_compat name="inventory_offer" label="Inventarangebot" />
				</panel>
				<panel name="log_settings">
					<plus_ps_text name="logging_label">
						Speichern:
					</plus_ps_text>
					<plus_ps_combo name="conversation_log_combo">
						<plus_ps_combo.item name="log_and_transcripts" label="Protokoll und Transkripte" />
						<plus_ps_combo.item name="log_only" label="Nur Protokoll" />
						<plus_ps_combo.item name="no_log_or_transcript" label="Weder Protokoll noch Transkripte" />
					</plus_ps_combo>
					<plus_ps_button_compat name="clear_log" label="Protokoll löschen..." />
					<plus_ps_button_compat name="delete_transcripts" label="Transkripte löschen..." />
					<plus_ps_text name="log_location_label">
						Standort:
					</plus_ps_text>
					<plus_ps_button_compat name="log_path_button" label="Durchsuchen..." label_selected="Durchblättern" />
				</panel>
				<plus_ps_button_compat name="ok_btn" label="Übersetzen..." />
				<plus_ps_button_compat name="autoreplace_showgui" label="Automatisch ersetzen..." />
				<plus_ps_button_compat name="spellcheck_showgui" label="Rechtschreibprüfung..." />
			</panel>
		</scroll_container>
	</plus_ps_box>
</panel>
