<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The Charis page (research/266 prefs-w-view) in this language: the words of the official panel_preferences_colors.xml, by name. -->
<panel label="Farben" name="colors_panel">
	<plus_ps_box name="ps_ground">
		<scroll_container name="colors_scroll">
			<panel name="colors_scroll_panel">
				<plus_ps_text name="effects_color_textbox">
					Meine Effekte (Auswahlstrahl):
				</plus_ps_text>
				<plus_ps_box name="glass_effect_color_swatch">
					<color_swatch tool_tip="Klicken Sie hier, um die Farbauswahl zu öffnen" name="effect_color_swatch"/>
				</plus_ps_box>
				<plus_ps_text name="font_colors">
					Schriftfarben für Chat:
				</plus_ps_text>
				<plus_ps_text name="text_box1">
					Ich
				</plus_ps_text>
				<plus_ps_text name="text_box2">
					Andere
				</plus_ps_text>
				<plus_ps_text name="text_box3">
					Objekte
				</plus_ps_text>
				<plus_ps_text name="text_box4">
					System
				</plus_ps_text>
				<plus_ps_text name="text_box5">
					Fehler
				</plus_ps_text>
				<plus_ps_text name="text_box10">
					Direkt
				</plus_ps_text>
				<plus_ps_text name="text_box7">
					Eigentümer
				</plus_ps_text>
				<plus_ps_text name="text_box9">
					URLs
				</plus_ps_text>
				<plus_ps_text name="bubble_chat">
					Hintergrundfarbe für Avatarnamen (wirkt sich auch auf Blasen-Chat aus):
				</plus_ps_text>
				<plus_ps_box name="glass_background">
					<color_swatch tool_tip="Farbe für Avatarnamen auswählen" name="background"/>
				</plus_ps_box>
				<plus_ps_slider_compat label="Deckkraft:" tool_tip="Deckkraft für Avatarnamen auswählen" name="bubble_chat_opacity"/>
				<plus_ps_text name="floater_opacity">
					Floater-Deckkraft:
				</plus_ps_text>
				<plus_ps_slider_compat label="Aktiv:" name="active"/>
				<plus_ps_slider_compat label="Inaktiv:" name="inactive"/>
			</panel>
		</scroll_container>
	</plus_ps_box>
</panel>
