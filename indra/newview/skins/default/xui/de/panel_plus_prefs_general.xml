<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_general.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="general_panel" label="Allgemein">
    <plus_ps_box name="ps_ground">
        <scroll_container name="general_scroll">
            <panel name="general_scroll_panel">
                <plus_ps_text name="language_textbox">
                    Sprache:
                </plus_ps_text>
                <plus_ps_combo name="language_combobox">
                    <plus_ps_combo.item name="English" label="English (Englisch)" />
                    <plus_ps_combo.item name="Danish" label="Dansk (Dänisch) - Beta" />
                    <plus_ps_combo.item name="Deutsch(German)" label="Deutsch - Beta" />
                    <plus_ps_combo.item name="Spanish" label="Español (Spanisch) - Beta" />
                    <plus_ps_combo.item name="French" label="Français (Französisch) - Beta" />
                    <plus_ps_combo.item name="Italian" label="Italiano (Italienisch) - Beta" />
                    <plus_ps_combo.item name="Polish" label="Polski (Polnisch) - Beta" />
                    <plus_ps_combo.item name="Portugese" label="Português (Portugiesisch) - Beta" />
                    <plus_ps_combo.item name="Russian" label="Русский (Russisch) – Beta" />
                    <plus_ps_combo.item name="Turkish" label="Türkçe (Türkisch) – Beta" />
                    <plus_ps_combo.item name="(Japanese)" label="日本語 (Japanisch) - Beta" />
                    <plus_ps_combo.item name="Traditional Chinese" label="正體中文 (Traditionelles Chinesisch) – Beta" />
                </plus_ps_combo>
                <plus_ps_text name="language_textbox2">
                    (Erfordert Neustart)
                </plus_ps_text>
                <plus_ps_text name="maturity_desired_prompt">
                    Ich möchte auf Inhalt mit folgender Einstufung zugreifen:
                </plus_ps_text>
                <plus_ps_combo name="maturity_desired_combobox">
                    <plus_ps_combo.item name="Desired_Adult" label="Generell, Moderat, Adult" />
                    <plus_ps_combo.item name="Desired_Mature" label="Generell und Moderat" />
                    <plus_ps_combo.item name="Desired_PG" label="Generell" />
                </plus_ps_combo>
                <plus_ps_check_compat name="favorites_on_login_check" label="Lieblingsstandorte auf dem Anmeldebildschirm anzeigen" />
                <plus_ps_text name="favorites_check_extra_text">
                    (Andere, die Ihren Computer benutzen, sehen sie ebenfalls)
                </plus_ps_text>
                <plus_ps_text name="name_tags_textbox">
                    Avatarnamen:
                </plus_ps_text>
                <plus_ps_radio name="Name_Tag_Preference">
                    <radio_item name="radio" label="Aus" />
                    <radio_item name="radio2" label="An" />
                    <radio_item name="radio3" label="Kurz anzeigen" />
                </plus_ps_radio>
                <plus_ps_check_compat name="show_my_name_checkbox1" label="Mein Name" />
                <plus_ps_check_compat name="show_slids" label="Benutzernamen" tool_tip="Benutzernamen wie berndschmidt123 anzeigen" />
                <plus_ps_check_compat name="display_names_check" label="Anzeigenamen anzeigen" tool_tip="Aktivieren Sie diese Option, um Anzeigenamen in Chat, IM, Avatarnamen usw. zu verwenden." />
                <plus_ps_check_compat name="show_friends" label="Freunde hervorheben" tool_tip="Avatarnamen Ihrer Freunde hervorheben" />
                <plus_ps_text name="inworld_typing_rg_label">
                    Drücken von Buchstabentasten:
                </plus_ps_text>
                <plus_ps_radio name="inworld_typing_preference">
                    <radio_item name="radio_start_chat" label="Startet lokalen Chat" />
                    <radio_item name="radio_move" label="Beeinflusst Bewegung (z. B. WASD)" />
                </plus_ps_radio>
                <plus_ps_text name="title_afk_text">
                    Zeit bis zur Abwesenheit:
                </plus_ps_text>
                <plus_ps_combo name="afk" label="Timeout für Abwesenheit:">
                    <plus_ps_combo.item name="item0" label="2 Minuten" />
                    <plus_ps_combo.item name="item1" label="5 Minuten" />
                    <plus_ps_combo.item name="item2" label="10 Minuten" />
                    <plus_ps_combo.item name="item3" label="30 Minuten" />
                    <plus_ps_combo.item name="item4" label="nie" />
                </plus_ps_combo>
                <plus_ps_text name="text_box3">
                    Nicht-stören-Antwort:
                </plus_ps_text>
                <plus_ps_box name="dnd_response_glass">
                    <text_editor name="do_not_disturb_response">
                        log_in_to_change
                    </text_editor>
                </plus_ps_box>
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
