<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_move.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="move_panel" label="Bewegen">
    <plus_ps_box name="ps_ground">
        <scroll_container name="move_scroll">
            <panel name="move_scroll_panel">
                <plus_ps_slider_compat name="camera_fov" label="Sichtwinkel" />
                <plus_ps_slider_compat name="camera_offset_scale" label="Abstand" />
                <plus_ps_text name="heading2">
                    Automatische Position für:
                </plus_ps_text>
                <plus_ps_check_compat name="edit_camera_movement" label="Bauen/Bearbeiten" tool_tip="Automatische Kamerapositionierung bei Wechsel in und aus dem Bearbeitungsmodus verwenden" />
                <plus_ps_check_compat name="appearance_camera_movement" label="Aussehen" tool_tip="Automatische Kamerapositionierung im Bearbeitenmodus verwenden" />
                <plus_ps_text name="keyboard_lbl">
                    Tastatur:
                </plus_ps_text>
                <plus_ps_check_compat name="arrow_keys_move_avatar_check" label="Mit Pfeiltasten bewegen" />
                <plus_ps_check_compat name="tap_tap_hold_to_run" label="Drücken-drücken-halten, um zu rennen" />
                <plus_ps_text name="mouse_lbl">
                    Maus:
                </plus_ps_text>
                <plus_ps_check_compat name="first_person_avatar_visible" label="Mich im Mouselook anzeigen" />
                <plus_ps_text name=" Mouse Sensitivity">
                    Mausempfindlichkeit für Mouselook:
                </plus_ps_text>
                <plus_ps_check_compat name="invert_mouse" label="Umkehren" />
                <plus_ps_text name="single_click_action_lbl">
                    Einmal auf Land klicken:
                </plus_ps_text>
                <plus_ps_combo name="single_click_action_combo">
                    <plus_ps_combo.item name="0" label="Keine Aktion" />
                    <plus_ps_combo.item name="1" label="Zu angeklicktem Ort bewegen" />
                </plus_ps_combo>
                <plus_ps_text name="double_click_action_lbl">
                    Auf Land doppelklicken:
                </plus_ps_text>
                <plus_ps_combo name="double_click_action_combo">
                    <plus_ps_combo.item name="0" label="Keine Aktion" />
                    <plus_ps_combo.item name="1" label="Zu angeklicktem Ort bewegen" />
                    <plus_ps_combo.item name="2" label="Zu angeklicktem Ort teleportieren" />
                </plus_ps_combo>
                <plus_ps_button_compat name="joystick_setup_button" label="Andere Geräte" />
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
