<!-- Full interface -->

    <panel
     name="animation_overrider_panel"
     left="8"
     top="20"
     right="-8"
     bottom="-4"
     follows="all"
     layout="topleft">

        <check_box
         name="ao_enabled"
         label="AO On"
         tool_tip="Replace your avatar's standing, walking, sitting... with the animations of the active set."
         control_name="PlusAOEnabled"
         left="0"
         top="2"
         width="200"
         height="16"
         follows="left|top"
         layout="topleft" />

        <combo_box
         name="ao_set_selection_combo"
         tool_tip="The set to edit. Type a name and press Enter to rename it."
         left="0"
         top_pad="6"
         right="-24"
         height="20"
         allow_text_entry="true"
         max_chars="51"
         follows="left|right|top"
         force_disable_fulltext_search="true"
         layout="topleft" />

        <button
         name="ao_activate"
         tool_tip="Play this set now."
         left_pad="4"
         width="20"
         height="20"
         image_overlay="Activate_Checkmark"
         follows="right|top"
         layout="topleft" />

        <check_box
         name="ao_default"
         label="Default"
         tool_tip="Play this set when you log in. Without a default set, the set of your last session plays."
         left="0"
         top_pad="6"
         width="120"
         height="16"
         follows="left|top"
         layout="topleft" />

        <menu_button
         name="ao_add"
         tool_tip="Make a new set (or a copy of this one)."
         menu_position="bottomright"
         top_delta="-2"
         right="-24"
         width="20"
         height="20"
         image_overlay="AddItem_Press"
         follows="right|top"
         layout="topleft" />

        <button
         name="ao_remove"
         tool_tip="Remove this set."
         left_pad="4"
         width="20"
         height="20"
         image_overlay="TrashItem_Press"
         follows="right|top"
         layout="topleft" />

        <check_box
         name="ao_sit_override"
         label="Override sits"
         tool_tip="Replace sitting animations too."
         left="0"
         top_pad="4"
         width="110"
         height="16"
         follows="left|top"
         layout="topleft" />

        <check_box
         name="ao_smart"
         label="Be smart"
         tool_tip="Stop the sit override while the object you sit on plays its own animation."
         left_pad="4"
         right="-1"
         height="16"
         follows="left|top"
         layout="topleft" />

        <check_box
         name="ao_disable_stands_in_mouselook"
         label="No stands in mouselook"
         tool_tip="Use the normal standing animation in mouselook."
         left="0"
         top_pad="4"
         width="240"
         height="16"
         follows="left|top"
         layout="topleft" />

        <combo_box
         name="ao_state_selection_combo"
         tool_tip="The state to edit. The number is how many animations it has."
         left="0"
         top_pad="6"
         right="-1"
         height="20"
         follows="left|right|top"
         layout="topleft" />

        <scroll_list
         name="ao_state_animation_list"
         tool_tip="Drop animations (several at once if you like), an inventory folder or an AO notecard on this window. Drop an animation on another to play both together (a group). Double-click an animation to play it now. Right-click for more."
         left="0"
         top_pad="4"
         right="-24"
         height="130"
         multi_select="true"
         draw_heading="false"
         follows="all"
         layout="topleft">
            <scroll_list.columns
             name="icon"
             dynamic_width="false"
             width="20" />
            <scroll_list.columns
             name="animation_name"
             dynamic_width="true" />
        </scroll_list>

        <panel
         name="ao_animation_move_trash_panel"
         left_pad="4"
         right="-1"
         height="130"
         follows="right|top|bottom"
         layout="topleft">

            <button
             name="ao_move_up"
             tool_tip="Move the selected animation or group up."
             left="0"
             top="0"
             width="20"
             height="24"
             image_overlay="Arrow_Up"
             follows="left|top"
             layout="topleft" />

            <button
             name="ao_move_down"
             tool_tip="Move the selected animation or group down."
             top_pad="4"
             width="20"
             height="24"
             image_overlay="Arrow_Down"
             follows="left|top"
             layout="topleft" />

            <button
             name="ao_rename"
             tool_tip="Rename the selected group."
             left_delta="0"
             bottom="-25"
             width="20"
             height="20"
             image_overlay="Edit_Wrench"
             follows="left|bottom"
             layout="topleft" />

            <button
             name="ao_trash"
             tool_tip="Remove the selected animations from this state (the animations stay in your inventory)."
             left_delta="0"
             bottom="-1"
             width="20"
             height="20"
             image_overlay="TrashItem_Press"
             follows="left|bottom"
             layout="topleft" />
        </panel>

        <combo_box
         name="ao_track_selection_combo"
         tool_tip="Which list of this state to show. The main list plays as usual; further tracks play and cycle by themselves next to it (a tail wag next to all walking animations, for example)."
         left="0"
         top_pad="6"
         right="-24"
         height="20"
         follows="left|right|bottom"
         layout="topleft" />

        <button
         name="ao_track_add"
         tool_tip="Add a track to this state."
         left_pad="4"
         width="20"
         height="20"
         image_overlay="AddItem_Press"
         follows="right|bottom"
         layout="topleft" />

        <check_box
         name="ao_cycle"
         label="Cycle"
         tool_tip="Play another animation of the list each time this state starts."
         left="0"
         top_pad="6"
         width="70"
         height="16"
         follows="left|bottom"
         layout="topleft" />

        <check_box
         name="ao_randomize"
         label="Random order"
         tool_tip="Cycle in random order."
         left_pad="4"
         right="-1"
         height="16"
         follows="left|bottom"
         layout="topleft" />

        <text
         name="ao_cycle_time_seconds_label"
         value="Cycle time (seconds):"
         left="0"
         top_pad="6"
         width="130"
         height="16"
         follows="left|bottom"
         layout="topleft" />

        <spinner
         name="ao_cycle_time"
         tool_tip="Switch to the next animation after this many seconds. 0: only when the state starts."
         top_delta="-2"
         left_pad="4"
         right="-1"
         height="20"
         label_width="0"
         decimal_digits="2"
         initial_value="0"
         min_val="0"
         max_val="999"
         increment="1"
         follows="left|right|bottom"
         layout="topleft" />

        <layout_stack
         name="ao_file_buttons_stack"
         left="0"
         top_pad="8"
         right="-1"
         height="20"
         orientation="horizontal"
         follows="left|right|bottom"
         layout="topleft">
            <layout_panel
             name="ao_import_panel"
             width="76"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_import"
                 label="Import..."
                 tool_tip="Make sets from an AO file (.charis-ao.xml). Animations are looked up in your inventory. To import a Firestorm/ZHAO notecard, drop it on this window."
                 left="0"
                 top="0"
                 right="-2"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
            <layout_panel
             name="ao_export_panel"
             width="76"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_export"
                 label="Export..."
                 tool_tip="Save this set to a file."
                 left="2"
                 top="0"
                 right="-2"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
            <layout_panel
             name="ao_export_all_panel"
             width="92"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_export_all"
                 label="Export All..."
                 tool_tip="Save all sets to one file."
                 left="2"
                 top="0"
                 right="-1"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
        </layout_stack>

        <layout_stack
         name="ao_reload_stack"
         left="0"
         top_pad="4"
         right="-1"
         height="20"
         orientation="horizontal"
         follows="left|right|bottom"
         layout="topleft">
            <layout_panel
             name="ao_reload_panel"
             width="92"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_reload"
                 label="Reload"
                 tool_tip="Read the #AO folder of your inventory again (after changing it in another viewer). The AO keeps playing."
                 left="0"
                 top="0"
                 right="-2"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
            <layout_panel
             name="ao_fs_import_panel"
             width="152"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_fs_import"
                 label="Get from Firestorm"
                 tool_tip="Copy the AO sets Firestorm keeps in your inventory (#Firestorm/#AO) into this viewer's #Charis/#AO folder. Sets with a name you already have are left out; Firestorm's own folder stays as it is."
                 left="2"
                 top="0"
                 right="-1"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
        </layout_stack>

        <layout_stack
         name="next_previous_buttons_stack"
         left="0"
         top_pad="4"
         right="-24"
         height="20"
         orientation="horizontal"
         follows="left|right|bottom"
         layout="topleft">
            <layout_panel
             name="next_previous_buttons_stack_left"
             width="90"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_previous"
                 tool_tip="Play the previous animation of the current state."
                 image_overlay="BackArrow_Off"
                 left="0"
                 top="0"
                 right="-2"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
            <layout_panel
             name="next_previous_buttons_stack_right"
             width="90"
             height="20"
             user_resize="false"
             follows="all"
             layout="topleft">
                <button
                 name="ao_next"
                 tool_tip="Play the next animation of the current state."
                 image_overlay="ForwardArrow_Off"
                 left="2"
                 top="0"
                 right="-1"
                 height="20"
                 follows="all"
                 layout="topleft" />
            </layout_panel>
        </layout_stack>

        <button
         name="ao_less"
         tool_tip="Show the small window."
         image_overlay="DisclosureArrow_Opened_Off"
         left_pad="4"
         width="20"
         height="20"
         follows="right|bottom"
         layout="topleft" />

        <text
         name="ao_status"
         left="0"
         top_pad="4"
         right="-1"
         height="16"
         follows="left|right|bottom"
         layout="topleft" />
    </panel>

<!-- Small interface -->

    <panel
     name="animation_overrider_panel_small"
     left="8"
     top="20"
     right="-8"
     height="70"
     visible="false"
     follows="left|right|top"
     layout="topleft">

        <check_box
         name="ao_enabled_small"
         label="AO On"
         tool_tip="Replace your avatar's standing, walking, sitting... with the animations of the active set."
         control_name="PlusAOEnabled"
         left="0"
         top="2"
         width="200"
         height="16"
         follows="left|top"
         layout="topleft" />

        <combo_box
         name="ao_set_selection_combo_small"
         tool_tip="Play this set."
         left="0"
         top_pad="4"
         right="-24"
         height="20"
         follows="left|right|top"
         force_disable_fulltext_search="true"
         layout="topleft" />

        <button
         name="ao_more"
         tool_tip="Show the full window for editing."
         image_overlay="Edit_Wrench"
         left_pad="4"
         right="-1"
         height="20"
         follows="right|top"
         layout="topleft" />

        <button
         name="ao_previous_small"
         tool_tip="Play the previous animation of the current state."
         image_overlay="BackArrow_Off"
         left="0"
         top_pad="4"
         width="62"
         height="20"
         follows="left|top"
         layout="topleft" />

        <button
         name="ao_next_small"
         tool_tip="Play the next animation of the current state."
         image_overlay="ForwardArrow_Off"
         left_pad="4"
         width="62"
         height="20"
         follows="left|top"
         layout="topleft" />

        <check_box
         name="ao_sit_override_small"
         label="Sits"
         tool_tip="Replace sitting animations too."
         left_pad="4"
         right="-1"
         height="16"
         follows="left|top"
         layout="topleft" />
    </panel>
</floater>
