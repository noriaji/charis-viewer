<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  Animation Overrider (plus/ao, from Firestorm's floater_ao.xml and panel_ao.xml).
  Control names are used by aofloater.cpp; the strings also by the engine's
  messages (aoText()). state_N are the display names of the states; the
  inventory folders keep Firestorm's English names.
-->
<floater
 positioning="centered"
 legacy_header_height="18"
 can_resize="true"
 can_minimize="true"
 can_close="true"
 height="462"
 min_height="428"
 width="260"
 min_width="240"
 layout="topleft"
 name="plus_ao"
 save_rect="true"
 single_instance="true"
 reuse_instance="true"
 title="ANIMATION OVERRIDER">
    <floater.string name="ao_no_sets_loaded">No sets yet: + makes one</floater.string>
