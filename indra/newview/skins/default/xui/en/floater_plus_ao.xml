    <floater.string name="ao_export_all_name">AO sets</floater.string>
    <floater.string name="ao_export_done">Wrote [COUNT] set(s) to [FILE].</floater.string>
    <floater.string name="ao_export_failed">Could not write [FILE].</floater.string>
