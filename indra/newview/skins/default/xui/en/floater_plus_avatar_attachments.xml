<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  The attachments of an avatar (plus/avatarattach): "Attachments..." in the context menu of an
  avatar or of one of its attachments. Control, column and string names are used by
  avatarattach.cpp. Sizes: header 18, status 22..38, list 42..(height - 34), buttons in the
  last 28 (22 high, 6 from the bottom). The buttons end at 350 and the "Refresh" button starts
  at width - 96, so min_width 480 keeps them apart.
-->
<floater
 positioning="cascading"
 legacy_header_height="18"
 save_rect="true"
 single_instance="true"
 reuse_instance="false"
 can_resize="true"
 can_minimize="true"
 can_close="true"
 min_width="480"
 min_height="200"
 height="320"
 width="560"
 layout="topleft"
 name="plus_avatar_attachments"
 title="ATTACHMENTS">
    <floater.string name="title_format">Attachments: [NAME]</floater.string>
    <floater.string name="loading">Loading...</floater.string>
    <floater.string name="name_unavailable">(not available)</floater.string>
    <floater.string name="no_name">(no name)</floater.string>
    <floater.string name="hud_point">HUD [POINT]</floater.string>
    <floater.string name="hud_distance">HUD</floater.string>
    <floater.string name="count_self">[COUNT] attachments</floater.string>
    <floater.string name="count_other">[COUNT] attachments (the HUDs of others are not sent to you)</floater.string>
    <floater.string name="none">Nothing attached.</floater.string>
    <floater.string name="gone">This avatar is not in view (gone, or too far away).</floater.string>
    <text
     follows="left|top|right"
     height="16"
     layout="topleft"
     left="8"
     right="-8"
     top="22"
     use_ellipses="true"
     name="status">
        Loading...
    </text>
    <scroll_list
     follows="all"
     layout="topleft"
     left="6"
     right="-6"
     top="42"
     bottom="-34"
     column_padding="0"
     draw_heading="true"
     multi_select="false"
     name="attachments_list"
     tool_tip="Double-click a row to inspect the object">
        <scroll_list.columns
         label="Attached to"
         name="point"
         width="130" />
        <scroll_list.columns
         dynamic_width="true"
         label="Name"
         name="name" />
        <scroll_list.columns
         label="Creator"
         name="creator"
         tool_tip="Who made the object"
         width="120" />
        <scroll_list.columns
         label="Prims"
         name="prims"
         tool_tip="Prims of the linkset (the root and its children)"
         width="56" />
        <scroll_list.columns
         label="Dist. (m)"
         name="distance"
         tool_tip="Distance from you in meters"
         width="64" />
    </scroll_list>
    <button
     follows="left|bottom"
     height="22"
     label="Copy Name"
     layout="topleft"
     left="6"
     bottom="-6"
     width="112"
     name="copy_name_btn"
     tool_tip="Copy the name of the selected object" />
    <button
     follows="left|bottom"
     height="22"
     label="Copy UUID"
     layout="topleft"
     left="122"
     bottom="-6"
     width="112"
     name="copy_id_btn"
     tool_tip="Copy the UUID of the selected object" />
    <button
     follows="left|bottom"
     height="22"
     label="Inspect"
     layout="topleft"
     left="238"
     bottom="-6"
     width="112"
     name="inspect_btn"
     tool_tip="Select the object and show its properties (as Inspect on its own menu)" />
    <button
     follows="right|bottom"
     height="22"
     label="Refresh"
     layout="topleft"
     right="-6"
     bottom="-6"
     width="90"
     name="refresh_btn"
     tool_tip="Update the list now and ask again for the names that did not come" />
</floater>
