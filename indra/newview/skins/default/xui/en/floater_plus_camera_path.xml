    <floater.string name="path_err_full">The path has the most points it can (32).</floater.string>
    <floater.string name="path_err_busy">Something is already playing. Stop it first.</floater.string>
    <floater.string name="path_err_spin_point">Choose a point other than the first: the turn happens while the camera moves into it.</floater.string>
    <floater.string name="list_motion_orbit">Orbit</floater.string>
    <floater.string name="list_orbit">[LAPS] lap</floater.string>
    <floater.string name="list_orbits">[LAPS] laps</floater.string>
    <floater.string name="list_spin">[TURNS] turn</floater.string>
    <floater.string name="list_spins">[TURNS] turns</floater.string>
    <floater.string name="path_err_spin_max">This point already has the most turns (8).</floater.string>
