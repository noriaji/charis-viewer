<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  Camera path (plus/camerapath): camera points the camera goes through in turn, smoothly or with a cut; shake;
  looking at an avatar; countdown; a picture for every frame. Control names and string names are used by
  camerapathfloater.cpp. The error strings (path_err_*) are the keys camerapath.cpp gives back.
  The timeline is a view the window makes inside the panel "timeline_holder".
-->
<floater
 positioning="cascading"
 save_rect="true"
 single_instance="true"
 reuse_instance="true"
 can_resize="false"
 can_minimize="true"
 can_close="true"
 legacy_header_height="18"
 height="564"
 width="420"
 layout="topleft"
 name="plus_camera_path"
 title="CAMERA PATH">
