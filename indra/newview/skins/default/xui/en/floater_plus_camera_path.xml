    <floater.string name="path_err_flycam">The flycam (3D mouse) is moving the camera. Turn it off first.</floater.string>
    <floater.string name="path_err_name">Enter a name to save under.</floater.string>
    <floater.string name="path_err_write">The path could not be saved.</floater.string>
    <floater.string name="path_err_read">The path could not be read.</floater.string>
    <floater.string name="path_err_script">The script is not a camera script (see the notes on the JSON format).</floater.string>
