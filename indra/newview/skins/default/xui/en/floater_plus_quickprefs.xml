<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  Quick Preferences (plus/quickprefs, from Firestorm's floater_quickprefs.xml).
  The rows of the list are made by quickprefsfloater.cpp from panel_plus_quickprefs_item.xml
  and put into options_stack; wl_options_stack below is the fixed part.
  Control names are used by quickprefsfloater.cpp. The qp_* strings are the labels of the
  default list (app_settings/plus/quickprefs/quick_preferences.xml, translation_id).
-->
<floater
 positioning="centered"
 legacy_header_height="18"
 can_resize="false"
 can_close="true"
 can_minimize="true"
 height="174"
 width="260"
 layout="topleft"
 name="plus_quickprefs"
 save_rect="true"
 save_visibility="true"
 single_instance="true"
 title="QUICK PREFERENCES">
    <floater.string name="qp_region_default">Shared Environment</floater.string>
    <floater.string name="qp_day_cycle_based">Day cycle based</floater.string>
    <floater.string name="qp_none">None</floater.string>
    <floater.string name="qp_no_valid_env">There is no sky, water or day cycle in your inventory to choose from.</floater.string>
    <floater.string name="qp_duplicate_control">The setting "[NAME]" is in the list already.</floater.string>
    <floater.string name="qp_restore_confirm">Put the list back to the standard one? Your own list is deleted.</floater.string>
    <floater.string name="qp_new_label">New setting</floater.string>
    <floater.string name="qp_draw_distance">Draw Distance</floater.string>
    <floater.string name="qp_max_particles">Max Particles</floater.string>
    <floater.string name="qp_avatar_physics_lod">Avatar Physics LOD</floater.string>
    <floater.string name="qp_lod_factor">LOD Factor</floater.string>
    <floater.string name="qp_max_avatars">Max Avatars</floater.string>
    <floater.string name="qp_name_tags">Name Tags</floater.string>
    <floater.string name="qp_color_under_cursor">Color Under Cursor</floater.string>
    <floater.string name="qp_bandwidth">Max Bandwidth</floater.string>

<panel
 name="quickprefs"
 left="0"
 top="16"
 width="260"
 height="152"
 follows="all"
 layout="topleft">
    <layout_stack
     layout="topleft"
     follows="all"
     name="options_stack"
     left="0"
     top="4"
     width="260"
     height="0"
     orientation="vertical"
     border_size="0">
        <!-- a dummy panel, as Firestorm has: a stack without a panel does not pass the XUI check -->
        <layout_panel
         layout="topleft"
         follows="all"
         name="dummy_options_panel"
         visible="false"
         height="20">
        </layout_panel>
    </layout_stack>

    <view_border
     layout="topleft"
     follows="left|right|bottom"
     name="divider_line_dynamic_to_static"
     top_pad="2"
     left="2"
     height="2"
     right="-2" />

    <layout_stack
     layout="topleft"
     follows="left|right|bottom"
     name="wl_options_stack"
     left="0"
     top_pad="0"
     width="260"
     height="144"
     orientation="vertical">

        <layout_panel
         layout="topleft"
         follows="all"
         name="wl_options_panel"
         invisibility_control="PlusQuickPrefsEditMode"
         height="144">
            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="5"
             name="HoverHeightLabel"
             tool_tip="How high your avatar hovers above the ground and objects"
             mouse_opaque="false"
             top="6"
             width="90">
                Hover Height:
            </text>
            <slider
             text_width="40"
             enabled="false"
             can_edit_text="true"
             decimal_digits="3"
             follows="left|right|top"
             height="16"
             increment="0.001"
             initial_value="0.0"
             layout="topleft"
             left="95"
             name="HoverHeightSlider"
             top="6"
             right="-7" />

            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="5"
             name="WL Sky"
             tool_tip="Your personal sky"
             mouse_opaque="false"
             top="36"
             width="55">
                Sky:
            </text>
            <combo_box
             follows="left|top"
             height="20"
             layout="topleft"
             left="63"
             name="WLPresetsCombo"
             top="34"
             width="150" />
            <button
             enabled="true"
             name="WLPrevPreset"
             follows="left|top"
             height="20"
             width="20"
             top="34"
             left="215"
             label=""
             label_selected=""
             image_overlay="Arrow_Left_Off"
             scale_image="true" />
            <button
             enabled="true"
             name="WLNextPreset"
             follows="left|top"
             height="20"
             width="20"
             top="34"
             left="236"
             label=""
             label_selected=""
             image_overlay="Arrow_Right_Off"
             scale_image="true" />

            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="5"
             name="WL Water"
             tool_tip="Your personal water"
             mouse_opaque="false"
             top="62"
             width="55">
                Water:
            </text>
            <combo_box
             follows="left|top"
             height="20"
             layout="topleft"
             left="63"
             name="WaterPresetsCombo"
             top="60"
             width="150" />
            <button
             enabled="true"
             name="WWPrevPreset"
             follows="left|top"
             height="20"
             width="20"
             top="60"
             left="215"
             label=""
             label_selected=""
             image_overlay="Arrow_Left_Off"
             scale_image="true" />
            <button
             enabled="true"
             name="WWNextPreset"
             follows="left|top"
             height="20"
             width="20"
             top="60"
             left="236"
             label=""
             label_selected=""
             image_overlay="Arrow_Right_Off"
             scale_image="true" />

            <text
             type="string"
             length="1"
             follows="left|top"
             height="16"
             layout="topleft"
             left="5"
             name="Day Cycle"
             tool_tip="Your personal day cycle"
             mouse_opaque="false"
             top="88"
             width="58">
                Day Cycle:
            </text>
            <combo_box
             follows="left|top"
             height="20"
             layout="topleft"
             left="63"
             name="DCPresetsCombo"
             top="86"
             width="150" />
            <button
             enabled="true"
             name="DCPrevPreset"
             follows="left|top"
             height="20"
             width="20"
             top="86"
             left="215"
             label=""
             label_selected=""
             image_overlay="Arrow_Left_Off"
             scale_image="true" />
            <button
             enabled="true"
             name="DCNextPreset"
             follows="left|top"
             height="20"
             width="20"
             top="86"
             left="236"
             label=""
             label_selected=""
             image_overlay="Arrow_Right_Off"
             scale_image="true" />

            <button
             enabled="true"
             name="btn_personal_lighting"
             follows="left|top"
             height="20"
             width="208"
             top="116"
             left="5"
             label="Personal Lighting...">
                <button.commit_callback
                 function="Floater.ToggleOrBringToFront"
                 parameter="env_adjust_snapshot" />
            </button>
            <button
             name="ResetToRegionDefault"
             label=""
             tool_tip="Go back to the shared environment of the region or parcel"
             enabled="true"
             top="116"
             left="215"
             height="20"
             width="20"
             follows="left|top"
             image_overlay="StopReload_Off"
             label_selected=""
             scale_image="true" />
            <!-- opens the edit overlay below -->
            <button
             name="button_edit"
             label=""
             tool_tip="Change which settings are listed here"
             top="116"
             left="236"
             height="20"
             width="20"
             follows="right|top"
             layout="topleft"
             control_name="PlusQuickPrefsEditMode"
             image_overlay="Edit_Wrench"
             toggle="true" />
        </layout_panel>
    </layout_stack>
</panel>

<!-- Edit overlay: covers the fixed part while the list is edited -->
<panel
 layout="topleft"
 follows="left|right|bottom"
 name="edit_overlay_panel"
 visibility_control="PlusQuickPrefsEditMode"
 left="1"
 top="-143"
 right="-1"
 height="143">

<view_border
 layout="topleft"
 follows="all"
 name="divider_line_edit_options"
 left="0"
 top="0"
 right="-1"
 height="2" />

<button
 layout="topleft"
 follows="left|top"
 name="move_up_button"
 tool_tip="Move the selected setting one place up"
 enabled_control="PlusQuickPrefsSelectedControl"
 image_overlay="Arrow_Up"
 top="8"
 left="4"
 width="20"
 height="23"/>

<button
 layout="topleft"
 follows="left|top"
 name="add_new_button"
 tool_tip="Add a setting to the list"
 image_overlay="AddItem_Off"
 left_pad="4"
 top_delta="0"
 width="20"
 height="23" />

<line_editor
 layout="topleft"
 follows="left|top"
 name="label_edit"
 enabled_control="PlusQuickPrefsSelectedControl"
 tool_tip="The name shown for the setting"
 label="Label:"
 left_pad="4"
 width="185"
 height="23" />

<button
 layout="topleft"
 follows="left|top"
 name="move_down_button"
 tool_tip="Move the selected setting one place down"
 enabled_control="PlusQuickPrefsSelectedControl"
 image_overlay="Arrow_Down"
 left="4"
 width="20"
 height="23" />

<combo_box
 layout="topleft"
 follows="left|top"
 name="control_name_combo"
 enabled_control="PlusQuickPrefsSelectedControl"
 tool_tip="Pick the setting from the list of debug settings"
 left_pad="4"
 width="225"
 height="23">
<combo_box.item
 type="string"
 label="=== Choose ==="
 name="control_name_list_header"
 value="" />
</combo_box>

<text
 layout="topleft"
 follows="left|top"
 name="control_type_label"
 enabled_control="PlusQuickPrefsSelectedControl"
 left="4"
 top_pad="8"
 width="42"
 height="23">
Type:
</text>

<combo_box
 layout="topleft"
 follows="left|top"
 name="control_type_combo_box"
 tool_tip="How the setting is shown and changed"
 enabled_control="PlusQuickPrefsSelectedControl"
 left_pad="4"
 top_delta="-5"
 width="135"
 height="23">
<!-- do not use <combo_item>Foo</combo_item>, it doesn't work -->
<combo_box.item
 type="string"
 label="Checkbox"
 name="Checkbox"
 value="0" />
<combo_box.item
 type="string"
 label="Text"
 name="Text"
 value="1" />
<combo_box.item
 type="string"
 label="Spinner"
 name="Spinner"
 value="2" />
<combo_box.item
 type="string"
 label="Slider"
 name="Slider"
 value="3" />
<combo_box.item
 type="string"
 label="Radio"
 name="Radio"
 value="4" />
<combo_box.item
 type="string"
 label="Color 3"
 name="Color 3"
 value="5" />
<combo_box.item
 type="string"
 label="Color 4"
 name="Color 4"
 value="6" />
</combo_box>

<!-- enabled or not by the code, depending on the type chosen -->
<check_box
 layout="topleft"
 enabled="false"
 follows="left|top"
 name="control_integer_checkbox"
 tool_tip="Tick this for a setting that has whole numbers only"
 enabled_control="PlusQuickPrefsSelectedControl"
 left_pad="4"
 height="20"
 top_delta="0"
 width="16"
 label="Integer" />

<spinner
 layout="topleft"
 enabled="false"
 follows="left|top"
 name="control_min_edit"
 tool_tip="The lowest value that can be chosen"
 enabled_control="PlusQuickPrefsSelectedControl"
 decimal_digits="2"
 label="Min:"
 label_width="32"
 min_val="-100000.0"
 max_val="100000.0"
 increment="1.0"
 left="4"
 top_pad="7"
 width="81"
 height="22" />
<spinner
 layout="topleft"
 enabled="false"
 follows="left|top"
 name="control_max_edit"
 tool_tip="The highest value that can be chosen"
 enabled_control="PlusQuickPrefsSelectedControl"
 decimal_digits="2"
 label="Max:"
 label_width="32"
 min_val="-100000.0"
 max_val="100000.0"
 increment="1.0"
 left_pad="4"
 width="81"
 height="22" />
<spinner
 layout="topleft"
 enabled="false"
 follows="left|top"
 name="control_increment_edit"
 tool_tip="How far one click on a spinner arrow or one cursor key moves the value"
 enabled_control="PlusQuickPrefsSelectedControl"
 decimal_digits="2"
 label="Step:"
 label_width="32"
 min_val="-100000.0"
 max_val="100000.0"
 increment="1.0"
 left_pad="4"
 width="81"
 height="22" />
<button
 layout="topleft"
 follows="right|top"
 name="Restore_Btn"
 tool_tip="Put the list back to the standard one"
 label="Reset"
 left="4"
 width="120"
 top_pad="4"
 height="16" />
<!-- the image names are the other way round because this is a toggle that is on -->
<button
 layout="topleft"
 follows="right|top"
 name="button_close"
 tool_tip="Close the edit panel"
 toggle="true"
 control_name="PlusQuickPrefsEditMode"
 image_unselected="Icon_Close_Press"
 image_selected="Icon_Close_Foreground"
 left="-18"
 width="16"
 top="10"
 height="16" />
</panel>

</floater>
