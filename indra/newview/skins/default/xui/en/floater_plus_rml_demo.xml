<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- The RmlUi test window (development; plus/rmlui/rmldemo.cpp, research/364). Its content is
     app_settings/plus/rmlui/demo.rml in a plus_rml_view filling the floater under its 18 px header; the RML lays it
     out (no heights to add here). The strings are the document's words ("[[name]]" in the RML). -->
<floater
  name="plus_rml_demo"
  title="RmlUi Test Window (Development)"
  can_close="true"
  can_minimize="true"
  can_resize="true"
  height="560"
  layout="topleft"
  legacy_header_height="18"
  min_height="320"
  min_width="320"
  positioning="cascading"
  reuse_instance="false"
  save_rect="true"
  single_instance="true"
  width="420">
  <string name="heading">RmlUi test window</string>
  <string name="button_count">Count</string>
  <string name="tip_count">Adds one to the number beside the button.</string>
  <string name="check_option">An option</string>
  <string name="tip_option">A check box bound to the data model (it changes nothing).</string>
  <string name="slider_label">Amount</string>
  <string name="tip_amount">A slider bound to the data model. The number beside it follows, and you can type a number there (Enter) to set it.</string>
  <string name="text_label">Text</string>
  <string name="tip_text">Type here. Japanese input (the IME) works too: compose, convert and confirm.</string>
  <string name="button_colour">Switch Colour</string>
  <string name="tip_colour">Sets the accent colour's CSS variable from the viewer, and back.</string>
  <string name="button_size">Switch Text Size</string>
  <string name="tip_size">Switches the body text's size variable, and back.</string>
  <string name="list_label">1000 rows: only the visible ones are made.</string>
  <string name="list_item">Row [N]</string>
  <string name="rml_unavailable">RmlUi is not used in safe mode.</string>
  <string name="rml_failed">The page could not be loaded (the log says why).</string>
  <plus_rml_view
    name="body"
    document="demo.rml"
    follows="all"
    layout="topleft"
    left="0"
    top="18"
    width="420"
    height="542" />
</floater>
