<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  Update check (plus/updatecheck): a newer Charis Viewer is out. Opened by updatecheck.cpp
  at the login screen or once the world is up. [VERSION] and [CURRENT] are versions
  ("0.1.0 alpha 2 (rev 1970)"); the message of the update file follows the body.
  The text is plain: no links in it (research/130 M1; a message could show one address
  and go to another, or run a secondlife:///app command). Pages open only from the
  button, after updatecheck.cpp has checked the address.
-->
<floater
 positioning="centered"
 save_rect="false"
 single_instance="true"
 reuse_instance="false"
 can_resize="false"
 can_minimize="false"
 can_close="true"
 legacy_header_height="18"
 height="236"
 width="460"
 layout="topleft"
 name="plus_update"
 title="NEW VERSION OF CHARIS VIEWER">
    <floater.string name="body">Charis Viewer [VERSION] is out. You are using [CURRENT].</floater.string>
    <floater.string name="body_required">Charis Viewer [CURRENT] is no longer supported. Please update to [VERSION].</floater.string>
    <floater.string name="notes">What's new: [URL]</floater.string>
    <floater.string name="page">Download page: [URL]</floater.string>
    <!-- btn_download when the update file names only the notes (no download page) -->
    <floater.string name="btn_notes">Open what's new</floater.string>
    <floater.string name="btn_notes_tip">Opens the page of what's new in your web browser (the update file names no download page)</floater.string>
    <text_editor
     follows="all"
     height="160"
     layout="topleft"
     left="10"
     max_length="4096"
     name="message"
     parse_urls="false"
     trusted_content="false"
     read_only="true"
     top="26"
     width="440"
     word_wrap="true" />
    <button
     follows="left|bottom"
     height="23"
     label="Open download page"
     layout="topleft"
     left="10"
     name="btn_download"
     tool_tip="Opens the download page in your web browser"
     top="200"
     width="160" />
    <button
     follows="left|bottom"
     height="23"
     label="Later"
     layout="topleft"
     left_pad="6"
     name="btn_later"
     tool_tip="Closes this. You will be reminded the next time you start the viewer, at least a day from now."
     top_delta="0"
     width="90" />
    <button
     follows="left|bottom"
     height="23"
     label="Skip This Version"
     layout="topleft"
     left_pad="6"
     name="btn_skip"
     tool_tip="You are told again only when a version newer than this one is out"
     top_delta="0"
     width="178" />
</floater>
