<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- Charis: the gear button of the Contact Sets tab of the People window (plus/contactsets/peopletab,
     research/333). From Firestorm's menu_people_contact_sets_gear.xml. -->
<toggleable_menu
 left="0"
 bottom="0"
 mouse_opaque="false"
 name="menu_people_contact_sets_gear"
 visible="false">
  <menu_item_call
   label="View Profile"
   name="profile">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="profile" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_selection" />
  </menu_item_call>
  <menu_item_call
   label="IM..."
   name="im">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="im" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_selection" />
  </menu_item_call>
  <menu_item_call
   label="Offer Teleport..."
   name="teleport">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="teleport" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_selection" />
  </menu_item_call>
  <menu_item_call
   label="Set Alias..."
   name="set_pseudonym">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="set_pseudonym" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_selection" />
  </menu_item_call>
  <menu_item_call
   label="Remove Alias"
   name="remove_pseudonym">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="remove_pseudonym" />
      <menu_item_call.on_visible
       function="ContactSet.Enable"
       parameter="has_pseudonym" />
  </menu_item_call>
  <menu_item_call
   label="Remove Display Name"
   name="remove_displayname">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="remove_display_name" />
      <menu_item_call.on_visible
       function="ContactSet.Enable"
       parameter="has_display_name" />
  </menu_item_call>
  <menu_item_call
   label="Set Options..."
   name="set_config">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="set_config" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_mutable_set" />
  </menu_item_call>
</toggleable_menu>
