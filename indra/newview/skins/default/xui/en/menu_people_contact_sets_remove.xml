<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- Charis: the trash button of the Contact Sets tab of the People window (plus/contactsets/peopletab,
     research/333). From Firestorm's menu_people_contact_sets_remove.xml. -->
<toggleable_menu
 left="0"
 bottom="0"
 mouse_opaque="false"
 name="menu_people_contact_sets_remove"
 visible="false">
  <menu_item_call
   label="Remove Set..."
   name="remove_set">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="remove_set" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_mutable_set" />
  </menu_item_call>
  <menu_item_call
   label="Remove from Set..."
   name="remove_contact">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="remove_contact" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_mutable_set_and_selection" />
  </menu_item_call>
  <menu_item_call
   label="Remove Alias"
   name="remove_alias">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="remove_pseudonym" />
      <menu_item_call.on_visible
       function="ContactSet.Enable"
       parameter="has_pseudonym" />
  </menu_item_call>
  <menu_item_call
   label="Remove Display Name"
   name="remove_display_name">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="remove_display_name" />
      <menu_item_call.on_visible
       function="ContactSet.Enable"
       parameter="has_display_name" />
  </menu_item_call>
  <menu_item_separator />
  <menu_item_call
   label="Move to Another Set..."
   name="move_contact">
      <menu_item_call.on_click
       function="ContactSet.Action"
       parameter="move_contact" />
      <menu_item_call.on_enable
       function="ContactSet.Enable"
       parameter="has_mutable_set_and_selection" />
  </menu_item_call>
</toggleable_menu>
