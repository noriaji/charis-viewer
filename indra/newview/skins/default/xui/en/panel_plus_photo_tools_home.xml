            <panel
             name="sec_home_lod"
             background_visible="false"
             follows="left|top"
             height="44"
             layout="topleft"
             left="10"
             top="393"
             width="583">
                <check_box
                 follows="left|top|right"
                 height="16"
                 label="Keep the detail when the camera moves away"
                 layout="topleft"
                 left="6"
                 right="-6"
                 top="4"
                 name="chk_home_lod"
                 tool_tip="Turns off the level of detail by distance (RenderDynamicLOD): things keep the detail they have close up, so they do not fall apart when the camera is pulled back. Back to normal when it is off." />
                <text
                 type="string"
                 length="1"
                 follows="left|top|right"
                 font="SansSerifSmall"
                 height="16"
                 layout="topleft"
                 left="24"
                 right="-6"
                 top="22"
                 name="lod_note">
                    Everything is drawn in full detail, so it can be slower.
                </text>
            </panel>
            <panel
             name="sec_home_guide"
             background_visible="false"
             follows="left|top"
             height="30"
             layout="topleft"
             left="10"
             top="437"
             width="583">
                <button
                 follows="left|top"
                 height="22"
                 is_toggle="true"
