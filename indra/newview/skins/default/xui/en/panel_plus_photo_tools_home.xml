<!--
  The photo tools' page "home" (floater_plus_photo_tools.xml, research/265).
  Home: the presets, "Adjust" (a column of a few rows of other tabs), the sky and water buttons and the
  favourites as buttons, the shutter and Stop the World, the photo's size, the level of detail, the guide, and the
  settings starred (a column). The blocks are run by phototools_blocks.cpp (the sky and water ones by
  phototools_env.cpp); pt-ui-blocks makes them over to psui.
  The parts of content_home are put under each other by the code in the order of their tops (the
  hidden ones take no room); a block keeps its height, a column (rows_*) gets the height of its rows.
  Blocks are 583 wide at 10, columns 597 at 0 (the content: the page less the scroll bar).
-->
<panel
 name="page_home"
 background_visible="false"
 follows="all"
 height="688"
 layout="topleft"
 mouse_opaque="false"
 width="612">
    <scroll_container
     name="scroll_home"
     border_visible="false"
     follows="all"
     height="688"
     ignore_arrow_keys="true"
     layout="topleft"
     left="0"
     opaque="false"
     reserve_scroll_corner="false"
     top="0"
     width="612">
        <panel
         name="content_home"
         background_visible="false"
         follows="left|top"
         height="688"
         layout="topleft"
         left="0"
         mouse_opaque="false"
         top="0"
         width="597">
            <panel
             name="sec_preset"
             background_visible="false"
             follows="left|top"
             height="130"
             layout="topleft"
             left="10"
             top="0"
             width="583">
                <text
                 type="string"
                 length="1"
                 follows="left|top"
                 font="SansSerifBold"
                 height="16"
                 layout="topleft"
                 left="6"
                 top="2"
                 name="title_preset"
                 tool_tip="Each preset sets several rows at once: Brightness, Color Tone, Light Direction, Shadow Depth, Contrast, Glare and Background Blur. Autumn Alley also sets a look, its screen effects and the softness of the shadows (another preset puts them back; Undo All goes back to the values the photo tools had when they were opened). The change is subtle: hold Compare to see before and after, then fine-tune those rows."
                 width="300">
                    Presets
                </text>
                <button
                 follows="left|top"
                 height="22"
                 label="Portrait"
                 layout="topleft"
                 left="4"
                 top="20"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_portrait"
                 tool_tip="Soft light for faces: Light Direction 30 (the sun a little beside the camera), lighter shadows, a little less contrast, a slightly warm tone and a strong Background Blur (with Depth of Field on). For close-ups and upper-body shots." />
                <button
                 follows="left|top"
                 height="22"
                 label="Backlight"
                 layout="topleft"
                 left="156"
                 top="20"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_backlight"
                 tool_tip="Turns the sun in front of the camera (Light Direction 180), behind the subject, so its outline shines; brighter, with lighter shadows so the face is not lost, and strong Glare. Best under a low sun: the sun keeps its height." />
                <button
                 follows="left|top"
                 height="22"
                 label="Sunset"
                 layout="topleft"
                 left="308"
                 top="20"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_sunset"
                 tool_tip="A strong warm, orange tone, the sun turned behind the subject at an angle (Light Direction 150), a little more contrast and darker shadows, medium Glare. The sun keeps its height: choose an evening sky first." />
                <button
                 follows="left|top"
                 height="22"
                 label="Night"
                 layout="topleft"
                 left="4"
                 top="46"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_night"
                 tool_tip="A cool, bluish tone, brighter so the dark parts stay visible, more contrast and darker shadows, and strong Glare so lamps and signs glow. The light direction is left alone: choose a night sky first." />
                <button
                 follows="left|top"
                 height="22"
                 label="Studio"
                 layout="topleft"
                 left="156"
                 top="46"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_studio"
                 tool_tip="No color tone (your own look comes back), no Glare, and the sun from the front at an angle (Light Direction 60) for clear shapes; the strongest Background Blur (with Depth of Field on). For showing outfits and items." />
                <button
                 follows="left|top"
                 height="22"
                 label="Natural"
                 layout="topleft"
                 left="308"
                 top="46"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_natural"
                 tool_tip="Brightness, shadows and contrast back to the standard, no color tone, weak Glare; the light direction is left alone. A plain base after trying the others, or for a picture as the world looks." />
                <button
                 follows="left|top"
                 height="22"
                 label="Autumn Alley"
                 layout="topleft"
                 left="4"
                 top="72"
                 width="148"
                 font="SansSerifSmall"
                 is_toggle="true"
                 tab_stop="false"
                 name="preset_autumn"
                 tool_tip="The Autumn Alley look (deep reds and oranges) with Clarity 35 and Texture 20, weak halation and vignette, slightly darker shadows and a little more contrast, weak Glare, and shadow edges soft enough for dappled light. The light direction and the quality (such as the shadow distance) are left alone: choose a low afternoon sky from the sky list first. Another preset puts the look and its effects back; Undo All goes back to the values the photo tools had when they were opened." />
                <combo_box
                 follows="left|top"
                 height="22"
                 label="My Presets"
                 layout="topleft"
                 left="4"
                 top="102"
                 width="150"
                 name="my_preset_list"
                 tool_tip="Your own presets: choose one to put it on" />
                <line_editor
                 follows="left|top"
                 height="22"
                 label="Name"
                 layout="topleft"
                 left="158"
                 top="102"
                 width="140"
                 max_length_chars="40"
                 name="ed_my_name"
                 tool_tip="The name to save under (empty: a number is given). Saving under a name already in the list replaces that preset." />
                <button
                 follows="left|top"
                 height="22"
                 label="Save Mine"
                 layout="topleft"
                 left="302"
                 top="102"
                 width="90"
                 name="btn_my_save"
                 tool_tip="Keep the settings now as a preset with this name" />
                <button
                 follows="left|top"
                 height="22"
                 label="Delete"
                 layout="topleft"
                 left="396"
                 top="102"
                 width="60"
                 name="btn_my_delete"
                 tool_tip="Delete the preset chosen in the list" />
            </panel>
            <panel name="rows_easy" background_visible="false" follows="left|top" height="1" layout="topleft" left="0" mouse_opaque="false" top="130" width="597" />
