                 layout="topleft"
                 left="4"
                 top="4"
                 width="100"
                 name="btn_home_guide"
                 tool_tip="Show lines over the screen to help the composition, and the frame of the photo when its shape is not the window's. They are not in the picture." />
                <combo_box
                 follows="left|top"
                 height="22"
                 layout="topleft"
                 left="108"
                 top="4"
