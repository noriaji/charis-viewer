            <panel
             name="sec_home_actions"
             background_visible="false"
             follows="left|top"
             height="82"
             layout="topleft"
             left="10"
             top="249"
             width="583">
                <!-- two rows: the photo and the freeze (wide enough for "Resume the World (stopped N s)"),
                     then the camera positions and the freeze's check box under it -->
                <button
                 follows="left|top"
                 height="22"
                 label="Take Photo"
                 layout="topleft"
                 left="4"
                 top="6"
                 width="150"
                 name="btn_home_shoot"
                 tool_tip="Take the photo now, at the size and shape set below, and save it. This window stays."
                 font="SansSerifBold" />
                <button
                 follows="left|top"
                 height="22"
                 label="Stop the World"
                 layout="topleft"
                 left="158"
                 top="6"
                 width="300"
                 name="btn_freeze"
                 tool_tip="Stop avatars, objects, particles, clouds and water where they are; press again to go on. The camera, the sky and every setting here keep working. Avatar poses cannot be adjusted meanwhile. The world goes on by itself when this window is closed or at a teleport." />
                <button
                 follows="left|top"
                 height="22"
                 label="Camera Positions..."
                 layout="topleft"
                 left="4"
                 top="30"
                 width="150"
                 name="btn_home_camera"
                 tool_tip="Go to the Camera tab" />
                <button
                 follows="left|top"
                 height="22"
                 label="Photo Screen..."
                 layout="topleft"
                 left="4"
                 top="56"
                 width="150"
                 name="btn_home_photoscreen"
                 tool_tip="Go into the photo screen: the whole window for taking pictures. The windows and bars go away and come back when you leave." />
                <check_box
                 control_name="PlusWorldFreezeAppearance"
                 follows="left|top"
                 height="16"
                 label="Also stop lights and colors (lightning, blinking)"
                 layout="topleft"
                 left="158"
                 top="33"
                 width="300"
                 name="chk_freeze_appearance"
                 tool_tip="While the world is stopped, lights, colors, glow and textures that a script switches (a lightning flash, a blinking sign) stay as they were at that moment, and catch up when the world goes on. New objects, avatars and their outfits, and what you are editing are not held. Off: only movement stops." />
            </panel>
            <panel
             name="sec_home_shot"
             background_visible="false"
             follows="left|top"
             height="62"
             layout="topleft"
             left="10"
             top="331"
             width="583">
                <combo_box
                 follows="left|top"
                 height="22"
                 layout="topleft"
                 left="4"
                 top="2"
                 width="226"
                 name="home_shot_size"
                 tool_tip="How big the photo is (the long side)" />
                <combo_box
                 follows="left|top"
                 height="22"
                 layout="topleft"
                 left="234"
                 top="2"
                 width="222"
                 name="home_shot_aspect"
                 tool_tip="The shape of the photo" />
                <text
                 type="string"
                 length="1"
                 word_wrap="true"
                 follows="left|top|right"
                 font="SansSerifSmall"
                 height="32"
                 layout="topleft"
                 left="8"
                 right="-6"
                 top="28"
                 name="home_shot_info">
                    -
                </text>
