<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window (from: official Second_Life_Release#d567465e-26.5 panel_preferences_controls.xml; research/266 4.
     prefs-w-setup). The official panel stays as it is (the ledger's source for tools/ui-parity-diff.py); this page has
     all it does (name, functions, choices) in the psui look (charis-ui-style, plus/prefscharis/prefs_tab_template.xml).
     The key table (LLPanelPreferenceControls) fills its columns and rows from control_table_contents_*.xml and
     scrolls by itself, so the page is not a scroll_container: the table's glass follows all and grows and shrinks with
     the window (448 high at the default page 515, 371 at the least 438). A click on a cell opens the keybind dialog
     (a floater of its own, LLSetKeyBindDialog); the C++ puts no widget of its own over the table.
     Page (1080 base): 10 + mode drop-down 33 (the Restore button 40 beside it, top 7) + 14 + table 448 + 10 = 515.
     Mode 300 at left 14 (ja's longest choice 16 x 13 = 208); Restore 160 at the right (400..560, the table's right
     edge; follows top|right); the table's glass at left 14, 546 wide (to 14 from the right: the table has its own
     scroll bar). -->
<panel
 name="controls_panel"
 border="true"
 follows="all"
 height="515"
 label="Controls"
 layout="topleft"
 left="0"
 top="0"
 width="574">
    <plus_ps_box
     name="ps_ground"
     follows="all"
     height="515"
     kind="panel"
     layout="topleft"
     left="0"
     top="0"
     width="574">
        <plus_ps_combo
         name="key_mode"
         follows="left|top"
         height="33"
         layout="topleft"
         left="14"
         top="10"
         width="300">
            <plus_ps_combo.item
             name="third_person"
             label="When in third person"
             value="1" />
            <plus_ps_combo.item
             name="first_person"
             label="When in first person mode (Mouselook)"
             value="0" />
            <plus_ps_combo.item
             name="edit_avatar"
             label="When editing avatar"
             value="2" />
            <plus_ps_combo.item
             name="sitting"
             label="When sitting"
             value="3" />
            <plus_ps_combo.item
             name="flycam"
             label="When using flycam"
             value="4" />
        </plus_ps_combo>
        <plus_ps_button_compat
         name="restore_defaults"
         follows="top|right"
         height="40"
         label="Restore Defaults"
         layout="topleft"
         left="400"
         tool_tip="Restores default values for all control modes."
         top="7"
         width="160" />
        <plus_ps_box
         name="controls_list_box"
         follows="all"
         height="448"
         kind="glass"
         layout="topleft"
         left="14"
         top="57"
         width="546">
            <scroll_list
             name="controls_list"
             background_visible="false"
             can_sort="false"
             column_padding="0"
             draw_border="false"
             draw_heading="true"
             fg_disable_color="ScrollUnselectedColor"
             follows="all"
             height="444"
             layout="topleft"
             left="2"
             multi_select="false"
             selection_type="header"
             top="2"
             width="542" />
        </plus_ps_box>
    </plus_ps_box>
</panel>
