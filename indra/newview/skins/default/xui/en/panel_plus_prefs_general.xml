                <plus_ps_text
                 name="text_box3"
                 follows="left|top|right"
                 height="24"
                 layout="topleft"
                 left="14"
                 length="1"
                 mouse_opaque="false"
                 top="519"
                 type="string"
                 width="529">
                    Do Not Disturb response:
                </plus_ps_text>
                <!-- the reply: the official text editor (see-through) on the one-line fields' box: the skin's
                     TextField_Off (FIELD_BG with the light border; ui-old-recolor). A glass box was hardly seen on
                     the panel. A panel does not follow the editor's focus, so the border stays as it is while
                     typing. The name stays (the translations lay over it by name) -->
                <panel
                 name="dnd_response_glass"
                 background_visible="true"
                 background_opaque="true"
                 bg_opaque_image="TextField_Off"
                 bg_alpha_image="TextField_Off"
                 follows="left|top"
                 height="60"
                 layout="topleft"
                 left="14"
                 mouse_opaque="false"
                 top="543"
                 width="529">
                    <text_editor
                     name="do_not_disturb_response"
                     bg_focus_color="Transparent"
                     bg_readonly_color="Transparent"
                     bg_writeable_color="Transparent"
                     commit_on_focus_lost="true"
                     control_name="DoNotDisturbModeResponse"
                     follows="all"
                     height="52"
                     layout="topleft"
                     left="4"
                     text_color="PsTextWhite"
                     text_readonly_color="PsTextDim"
                     top="4"
                     use_ellipses="false"
                     width="521"
                     word_wrap="true">
                        log_in_to_change
                    </text_editor>
                </panel>
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
