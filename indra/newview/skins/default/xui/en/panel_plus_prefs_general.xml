<!-- Charis window (from: official Second_Life_Release#d567465e-26.5 panel_preferences_general.xml;
     research/266 4. prefs-w-basic). The official panel stays as it is (the ledger's source for
     tools/ui-parity-diff.py); this page has all it does (name, control_name, functions, strings, choices,
     ranges) in the psui look (charis-ui-style, plus/prefscharis/prefs_tab_template.xml).
     Height of the list (1080 base): 10 + language 33 + note 18 + time 33 + 10 + maturity 33 + its text 18
     + favourites 30 + note 18 + 10 + heading 40 + name tags 33 + 4 + checks 30 + 30 + group tags 33 + 10
     + heading 40 + letter keys 33 + 10 + away 33 + 10 + label 24 + reply 60 + 14 = 617 (scrolls in 515).
     Rows at left 14, 529 wide: label 230 | 12 | drop-down 287 (the longest language name is 255);
     two columns of 258; the rating icons (the C++ shows them by the maturity) after its drop-down (223).
     ja: 38 characters a row. -->
<panel
 name="general_panel"
 border="true"
 follows="all"
 height="515"
 label="General"
 layout="topleft"
 left="0"
 top="0"
 width="574">
    <plus_ps_box
     name="ps_ground"
     follows="all"
     height="515"
     kind="panel"
     layout="topleft"
     left="0"
     top="0"
     width="574">
