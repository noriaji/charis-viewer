  <string name="PlusRadarRegionLeave">left the region.</string>
  <!-- protectedfolders: shown when a protected folder is refused a delete or move (plus/protectedfolders) -->
  <string name="PlusProtectedFolderMoveRefused">The folder "[NAME]" is protected, so it was not moved or deleted. Unprotect it first (right-click it, or Charis > Protected Folders).</string>
  <string name="PlusProtectedFolderTrashRefused">The folder "[NAME]" holds the protected folder "[INSIDE]", so it was not moved to the Trash. Move "[INSIDE]" out of it or unprotect it first.</string>
  <string name="PlusProtectedFolderRemoveRefused">The folder "[NAME]" holds the protected folder "[INSIDE]", so it was not deleted or emptied. Move "[INSIDE]" out of it or unprotect it first.</string>
  <string name="PlusProtectedFolderNoMoveTip">This folder is protected: it cannot be moved.</string>
  <string name="PlusProtectedFolderNoTrashTip">It holds the protected folder "[INSIDE]": it cannot go to the Trash.</string>
  <string name="PlusProtectedFolderEmptyTrash">The Trash holds folders you protected: [NAMES]. Protection does not hold in the Trash, so emptying it deletes them for good, and they are no longer protected. Empty the Trash?</string>
  <!-- keywords: the notice on the screen (PlusKeywordsToast) -->
  <string name="PlusKeywordsAlert">Keyword "[WORD]": [NAME]: [TEXT]</string>
