<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Strings of the features ported from other viewers (indra/newview/plus/). Read after
  strings.xml (llappviewer.cpp, an official-file hook); the other languages' files override
  these by name, as they do strings.xml.
-->
<strings>
  <!-- quickprefs: the toolbar button (app_settings/commands_plus.xml) -->
  <string name="Command_PlusQuickprefs_Label">Quick prefs</string>
  <string name="Command_PlusQuickprefs_Tooltip">Quick preferences for changing often used settings</string>
  <!-- photomode: the toolbar button (app_settings/commands_plus.xml) -->
  <string name="Command_PlusPhotoTools_Label">Photo tools</string>
  <string name="Command_PlusPhotoTools_Tooltip">Photo tools: presets, sky, camera positions, picture settings and the photo button</string>
