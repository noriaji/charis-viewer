  <!-- posermcp: the notices of the MCP server (plus/posermcp) -->
  <string name="PlusMcpBadPort">MCP server: the port [PORT] (setting [SETTING]) must be between 1024 and 65535.</string>
  <string name="PlusMcpStartFailed">MCP server could not start: [ERROR]. Change [SETTING] or close the program using that port.</string>
  <string name="PlusMcpListening">MCP server: [URL]</string>
  <string name="PlusMcpConnectionFile">URL and token: [PATH]</string>
  <string name="PlusMcpCannotWrite">Could not write [PATH]</string>
  <string name="PlusMcpStopped">MCP server stopped.</string>
  <string name="PlusMcpNewToken">MCP: new token written to [PATH]. Update your MCP client settings.</string>
  <string name="PlusMcpNewTokenStopped">MCP: a new token was made, and the old one was taken out of [PATH]. The server is stopped: the new token is written there when it starts; update your MCP client settings then.</string>
  <string name="PlusMcpTokenNotWritten">MCP: could not write [PATH]</string>
  <string name="PlusMcpTokenDropped">The token was revoked, in case your MCP client sent it to the program on that port. A new one is written to [PATH] when the server starts; update your MCP client settings then.</string>
  <string name="PlusMcpServedElsewhere">Another viewer of this Windows user is running the MCP server on this port: [PATH] is left as it is, and your MCP client keeps using that viewer.</string>
  <string name="PlusMcpNewTokenElsewhere">MCP: another viewer of this Windows user is running the MCP server on this port. Make the new token in that viewer ([PATH] is left as it is).</string>
  <!-- invcache: Preferences > Advanced > Clear Inventory Cache (plus/invcache) -->
  <string name="PlusInvCacheConfirm">Clear the inventory cache? It is deleted at your next login, and the whole inventory is loaded from the server again, so that login takes longer than usual. Nothing in your inventory is deleted.</string>
