  <!-- outfitbackup: the question at login and the result -->
  <string name="PlusOutfitBackupAsk">What you wore at the end of your last session does not seem to have been saved on the server.</string>
  <string name="PlusOutfitBackupItems">- Worn items: [COUNT] different</string>
  <string name="PlusOutfitBackupOrder">- Worn items: the layer order differs</string>
  <string name="PlusOutfitBackupPlaces">- Position, rotation or size of attachments: [COUNT] different</string>
  <string name="PlusOutfitBackupAskQuestion">Put it back as it was at the end of the last session? (Cancel keeps what you wear now.)</string>
  <string name="PlusOutfitBackupDone">Your outfit was put back as it was at the end of the last session.</string>
  <string name="PlusOutfitBackupMissing">[COUNT] item(s) no longer in your inventory were left out.</string>
  <string name="PlusOutfitBackupNotPlaced">[COUNT] attachment(s) could not be put back in place (not worn, or not modifiable).</string>
  <string name="PlusOutfitBackupRlv">RLV restrictions: [KEPT] worn item(s) stayed on, [DROPPED] item(s) were not worn.</string>
  <string name="PlusOutfitBackupFailed">Your outfit could not be put back: the server did not change what you wear. The copy is kept, and you will be asked again at your next login. If you change what you wear before then, that replaces the copy.</string>
