<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="prefs_graphics_advanced" title="PREFERENCIAS DE GRÁFICOS AVANZADAS">
	<!-- plus: gfx-tabs (research/238). The rows sit in the tabs of en, wrapped the same way
	     (tab_container / panel / scroll_container / panel), or the translation does not apply. -->
	<tab_container name="graphics_tabs">
		<panel label="General" name="General">
			<scroll_container name="general_scroll">
				<panel name="general_scroll_panel">
					<text name="ShadersText">
						Shaders
					</text>
					<check_box initial_value="true" label="Agua transparente" name="TransparentWater"/>
					<check_box initial_value="true" label="Oclusión ambiental" name="UseSSAO"/>
					<text name="RenderShadowDetailText">
						Sombras:
					</text>
					<combo_box name="ShadowDetail">
						<combo_box.item label="Ninguno" name="0"/>
						<combo_box.item label="Sol/Luna" name="1"/>
						<combo_box.item label="Sol/Luna + Proyectores" name="2"/>
					</combo_box>
					<slider label="Distancia de dibujo:" name="DrawDistance"/>
					<text name="DrawDistanceMeterText2">
						m
					</text>
					<slider label="Cant. máx. de partículas:" name="MaxParticleCount"/>
					<text name="AvatarText">
						Avatar
					</text>
					<slider label="Complejidad máxima:" name="IndirectMaxComplexity" tool_tip='Controla en qué momento un avatar visualmente complejo se dibuja como un "JellyDoll"'/>
					<text name="IndirectMaxComplexityText">
						0
					</text>
					<slider label="N.º máx. de avatares no simulados:" name="IndirectMaxNonImpostors"/>
					<text name="IndirectMaxNonImpostorsText">
						0
					</text>
					<slider label="Física:" name="AvatarPhysicsDetail"/>
					<text name="AvatarPhysicsDetailText">
						Bajo
					</text>
					<text name="MeshText">
						Nivel de detalle (LOD)
					</text>
					<slider label="Objetos:" name="ObjectMeshDetail"/>
					<text name="ObjectMeshDetailText">
						Bajo
					</text>
					<slider label="Prims flexibles:" name="FlexibleMeshDetail"/>
					<text name="FlexibleMeshDetailText">
						Bajo
					</text>
					<slider label="Árboles:" name="TreeMeshDetail"/>
					<text name="TreeMeshDetailText">
						Bajo
					</text>
					<slider label="Avatares:" name="AvatarMeshDetail"/>
					<text name="AvatarMeshDetailText">
						Bajo
					</text>
					<slider label="Terreno:" name="TerrainMeshDetail"/>
					<text name="TerrainMeshDetailText">
						Bajo
					</text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Hardware" name="Hardware Settings">
			<scroll_container name="hardware_scroll">
				<panel name="hardware_scroll_panel">
					<check_box initial_value="true" label="Activar la compresión de texturas (requiere reiniciar)" name="texture compression" tool_tip="Comprime las texturas en la memoria de vídeo, lo cual permite cargar texturas de una resolución más alta, pero con una cierta pérdida de calidad del color."/>
					<text name="antialiasing label">
						Antialiasing:
					</text>
					<combo_box label="Antialiasing" name="fsaa">
						<combo_box.item label="Inhabilitado" name="FSAADisabled"/>
					</combo_box>
					<text name="antialiasing restart">
						(requiere reiniciar)
					</text>
					<check_box initial_value="true" label="Activar soporte para visores HiDPI (requiere reiniciar)" name="use HiDPI" tool_tip="Activar OpenGl para Dibujos de alta resolución."/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Dibujo" name="Rendering">
			<scroll_container name="rendering_scroll">
				<panel name="rendering_scroll_panel">
					<text name="Texture Rendering">
						Dibujo de texturas
					</text>
					<text name="Miscellaneous Rendering">
						Dibujo (varios)
					</text>
					<slider label="Calidad del procesamiento:" name="RenderPostProcess"/>
					<text name="PostProcessText">
						Bajo
					</text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Profundidad de campo" name="DOF panel">
			<scroll_container name="dof_scroll">
				<panel name="dof_scroll_panel">
					<check_box initial_value="true" label="Profundidad de campo (difumina la vista excepto en el punto de foco de la cámara)" name="UseDoF"/>
					<check_box name="RenderDepthOfFieldInEditMode" label="Activar durante el modo de edición"/>
					<slider name="CameraFNum" label="Apertura de diafragma (F):" tool_tip="Valor F de la cámara para el efecto PDC"/>
					<slider name="CameraFocal" label="Distancia focal (mm):" tool_tip="Distancia focal de la cámara para el efecto PDC (en milímetros)"/>
					<slider name="Camera FOV" label="Campo de visión (º):" tool_tip="Campo de visión vertical para el efecto PDC (en grados)"/>
					<slider name="CameraFocusTrans" label="Tiempo de transición del foco:" tool_tip="Tiempo que lleva ajustar el foco entre un punto y el siguiente"/>
					<slider name="CameraDoFResScale" label="Calidad de dibujo de la PDC:" tool_tip="Afecta a la calidad del difuminado y al rendimiento del dibujo (más alto = mayor calidad, más bajo = mayor rendimiento)"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Charis" name="Charis panel">
			<scroll_container name="charis_scroll">
				<panel name="charis_scroll_panel">
				</panel>
			</scroll_container>
		</panel>
	</tab_container>
	<!-- /plus -->
	<button label="Restablecer la configuración recomendada" name="Defaults"/>
	<button label="OK" label_selected="OK" name="OK"/>
	<button label="Cancelar" label_selected="Cancelar" name="Cancel"/>
	<check_box label="RenderAvatarMaxComplexity" name="RenderAvatarMaxComplexity"/>
	<check_box label="RenderAvatarMaxNonImpostors" name="RenderAvatarMaxNonImpostors"/>
</floater>
