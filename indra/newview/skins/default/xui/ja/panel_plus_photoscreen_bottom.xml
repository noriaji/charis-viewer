<!-- ja: the words only. Places and sizes come from en/panel_plus_photoscreen_bottom.xml (LLXMLNode::updateNode matches by name). -->
<panel name="plus_photoscreen_bottom">
    <string name="sub_pose">ポーザーで開きます</string>
    <string name="sub_portrait">顔にやわらかい光</string>
    <string name="sub_backlight">後ろからの光</string>
    <string name="sub_sunset">低く暖かい日差し</string>
    <string name="sub_night">暗い空と灯り</string>
    <string name="sub_studio">むらのない素直な光</string>
    <string name="sub_natural">空のままの光</string>
    <string name="name_autumn">秋の路地</string>
