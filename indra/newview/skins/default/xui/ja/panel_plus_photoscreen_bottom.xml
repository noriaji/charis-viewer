    <string name="add_tip_my">今の設定を自分のプリセットとして保存します（小さな写真つき）</string>
    <plus_ps_box name="box">
        <plus_ps_row name="ptabs">
            <!-- The tabs are wider in ja than in en (the words are longer). -->
            <plus_ps_tab name="ptab_camera" label="カメラプリセット" width="132" />
            <plus_ps_tab name="ptab_pose" label="ポーズプリセット" left="140" width="132" />
            <plus_ps_tab name="ptab_scene" label="シーンプリセット" left="280" width="132" />
            <plus_ps_tab name="ptab_my" label="マイプリセット" left="420" width="120" />
