<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- 環境設定 > 色（Charis のページ、research/266 prefs-w-view）の ja。en と同じ名前の鎖で文言だけ。訳は公式の ja
     （panel_preferences_colors.xml）から。 -->
<panel label="色" name="colors_panel">
	<plus_ps_box name="ps_ground">
		<scroll_container name="colors_scroll">
			<panel name="colors_scroll_panel">
				<plus_ps_text name="effects_color_textbox">
					自分のエフェクト（選択ビーム）：
				</plus_ps_text>
				<plus_ps_box name="glass_effect_color_swatch">
					<color_swatch name="effect_color_swatch" tool_tip="クリックしてカラーピッカーを開きます"/>
				</plus_ps_box>
				<plus_ps_text name="font_colors">
					チャットの文字の色：
				</plus_ps_text>
				<plus_ps_text name="text_box1">
					自分
				</plus_ps_text>
				<plus_ps_text name="text_box2">
					他人
				</plus_ps_text>
				<plus_ps_text name="text_box3">
					オブジェクト
				</plus_ps_text>
				<plus_ps_text name="text_box4">
					システム
				</plus_ps_text>
				<plus_ps_text name="text_box5">
					エラー
				</plus_ps_text>
				<plus_ps_text name="text_box10">
					ダイレクト
				</plus_ps_text>
				<plus_ps_text name="text_box7">
					所有者
				</plus_ps_text>
				<plus_ps_text name="text_box9">
					URL
				</plus_ps_text>
				<plus_ps_text name="text_mentions">
					メンション
				</plus_ps_text>
				<plus_ps_text name="mentions_colors">
					チャットのメンションの強調色：
				</plus_ps_text>
				<plus_ps_text name="text_mentions_self">
					自分
				</plus_ps_text>
				<plus_ps_text name="text_mentions_others">
					他人
				</plus_ps_text>
				<plus_ps_text name="bubble_chat">
					名前の表示の背景色（吹き出しチャットにも適用）：
				</plus_ps_text>
				<plus_ps_box name="glass_background">
					<color_swatch name="background" tool_tip="名前の表示色を選択"/>
				</plus_ps_box>
				<plus_ps_slider_compat label="不透明度：" name="bubble_chat_opacity" tool_tip="名前の表示の不透明度を選択"/>
				<plus_ps_text name="floater_opacity">
					フローターの透過度：
				</plus_ps_text>
				<plus_ps_slider_compat label="アクティブなフローター：" name="active"/>
				<plus_ps_slider_compat label="非アクティブなフローター：" name="inactive"/>
			</panel>
		</scroll_container>
	</plus_ps_box>
</panel>
