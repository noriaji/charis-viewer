<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- 環境設定「ゲームパッド」（Charis の作り、research/266 prefs-w-gamepad）の日本語。名前の鎖は en の panel_plus_prefs_game_control.xml と同じ。
     訳は公式の panel_preferences_game_control.xml の ja（gamecontrol-ja）から写した。サブタブの名前は帯（574）に収まるように短くし、正式の名前はタブのツールチップに書いた。 -->
<panel label="ゲームパッド" name="game_control_panel">
	<plus_ps_box name="ps_ground">
		<plus_ps_tabs name="game_control_tabs">
			<panel label="操作" name="tab_action_mappings" tool_tip="操作の割り当て: ゲームパッドのスティックとボタンで何をするかを、モードごとに決めます。">
				<plus_ps_combo name="action_mode" tool_tip="割り当てを編集するモードを選びます。">
					<plus_ps_combo.item label="アバターを動かすとき" name="avatar"/>
					<plus_ps_combo.item label="一人称視点のとき（マウスルック）" name="mouselook"/>
					<plus_ps_combo.item label="フライカムのとき" name="flycam"/>
					<plus_ps_combo.item label="着席時" name="captive"/>
					<plus_ps_combo.item label="マウスカーソルを使うとき" name="cursor"/>
				</plus_ps_combo>
				<plus_ps_check_compat label="このモードを使う" name="action_mode_enabled" tool_tip="オフにすると、このモードの割り当てを固定し、ゲームパッドの入力をこのモードの操作に変えなくなります。"/>
				<plus_ps_button_compat label="初期設定に戻す" name="restore_actions_defaults" tool_tip="選んでいるモードの割り当てを初期設定に戻します。"/>
				<plus_ps_check_compat label="傾きを使う" name="flycam_allow_roll" tool_tip="傾ける入力で、フライカムを前向きの軸のまわりに回せるようにします。フライカムの割り当てを編集している時だけ表示されます。"/>
				<plus_ps_text name="speed_slow_label">遅い</plus_ps_text>
				<plus_ps_slider_compat name="speed_factor" tool_tip="フライカム: カメラの移動の速さ。一人称視点: 向きを変える・見回す速さ。アバター: 向きを変える速さ。フライカム、一人称視点、アバターの割り当てを編集している時だけ表示されます。"/>
				<plus_ps_text name="speed_fast_label">速い</plus_ps_text>
				<plus_ps_check_compat label="カーソルを隠す" name="flycam_hide_cursor" tool_tip="フライカムで飛んでいる間、マウスカーソルを隠します。マウスを動かすと現れ、5 秒後（フライカムが動けば 1 秒以内）にまた隠れます。フライカムの割り当てを編集している時だけ表示されます。"/>
				<plus_ps_check_compat label="照準を表示" name="flycam_crosshair" tool_tip="フライカムで飛んでいる間、画面の中央に照準を描きます。フライカムの割り当てを編集している時だけ表示されます。"/>
				<plus_ps_text name="current_mode_indicator">今のモード:</plus_ps_text>
				<panel name="action_mappings_panel">
					<panel name="action_mappings_axes_panel">
						<plus_ps_box name="action_mappings_axes_glass">
							<scroll_list name="action_mappings_axes">
								<scroll_list.columns label="操作" name="action"/>
								<scroll_list.columns label="入力" name="input"/>
								<scroll_list.columns label="軸" name="input_description"/>
								<scroll_list.columns label="反転" name="invert"/>
							</scroll_list>
						</plus_ps_box>
					</panel>
					<panel name="action_mappings_buttons_panel">
						<plus_ps_box name="action_mappings_buttons_glass">
							<scroll_list name="action_mappings_buttons">
								<scroll_list.columns label="操作" name="action"/>
								<scroll_list.columns label="入力" name="input"/>
								<scroll_list.columns label="ボタン" name="input_description"/>
							</scroll_list>
						</plus_ps_box>
					</panel>
				</panel>
			</panel>
			<panel label="機器" name="tab_device_mappings" tool_tip="機器の割り当て: 選んだ機器の軸とボタンを、ビューワでどう扱うかを決めます。">
				<plus_ps_text name="nodevice_message">機器がつながっていません</plus_ps_text>
				<plus_ps_text name="device_prompt">機器:</plus_ps_text>
				<plus_ps_button_compat label="初期設定に戻す" name="restore_device_defaults" tool_tip="選んでいる機器の設定を初期設定に戻します。"/>
				<plus_ps_check_compat label="過去の機器も表示" name="show_all_known_devices"/>
				<panel name="device_settings">
					<panel name="axis_channels_panel">
						<plus_ps_box name="axis_channels_glass">
							<scroll_list name="axis_channels">
								<scroll_list.columns label="機器の入力" name="input_description"/>
								<scroll_list.columns label="ビューワでの扱い" name="output_description"/>
							</scroll_list>
						</plus_ps_box>
					</panel>
					<panel name="button_channels_panel">
						<plus_ps_box name="button_channels_glass">
							<scroll_list name="button_channels">
								<scroll_list.columns label="機器の入力" name="input_description"/>
								<scroll_list.columns label="ビューワでの扱い" name="output_description"/>
							</scroll_list>
						</plus_ps_box>
					</panel>
				</panel>
			</panel>
			<panel label="機器の調整" name="tab_device_options" tool_tip="機器の調整: 選んだ機器の今の入力と、軸ごとの中心ずれ・反転・遊び。">
				<plus_ps_text name="state_nodevice_message">機器がつながっていません</plus_ps_text>
				<plus_ps_text name="state_device_prompt">機器:</plus_ps_text>
				<plus_ps_button_compat label="初期設定に戻す" name="restore_device_options_defaults" tool_tip="選んでいる機器のすべての軸の中心ずれ・反転・遊びを初期設定に戻します。"/>
				<plus_ps_button_compat label="自動調整" name="auto_calibrate" tool_tip="選んでいる機器の軸の値を 5 フレーム分読み取ります。動かなかった軸は手を離した状態とみなし、その値から中心ずれと遊びを決めます。"/>
				<panel name="device_state_settings">
					<panel name="axis_state_panel">
						<plus_ps_box name="axis_state_glass">
							<!-- 軸の名前（左スティック ↔ など）が英語より長いので、入力・遊びを詰めて軸・補正後の値を広げた（合計 1.00） -->
							<scroll_list name="axis_state">
								<scroll_list.columns label="入力" name="input_glyph" relative_width="0.10"/>
								<scroll_list.columns label="軸" name="input" relative_width="0.22"/>
								<scroll_list.columns label="生の値" name="raw_value"/>
								<scroll_list.columns label="中心ずれ" name="offset"/>
								<scroll_list.columns label="反転" name="invert"/>
								<scroll_list.columns label="遊び" name="dead_zone" relative_width="0.12"/>
								<scroll_list.columns label="補正後の値" name="fixed_value" relative_width="0.22"/>
							</scroll_list>
						</plus_ps_box>
					</panel>
					<panel name="button_state_panel">
						<plus_ps_box name="button_state_glass">
							<scroll_list name="button_state">
								<scroll_list.columns label="入力" name="input_glyph"/>
								<scroll_list.columns label="ボタン" name="input"/>
								<scroll_list.columns label="値" name="value"/>
							</scroll_list>
						</plus_ps_box>
					</panel>
				</panel>
			</panel>
			<panel label="サーバー送信" name="tab_server_data" tool_tip="サーバー送信: ゲームパッドの入力とともにリージョンへ送るデータを、送ったとおりに表示します。">
				<plus_ps_check_compat label="ゲームパッドの入力を送る" name="game_control_to_server"/>
				<plus_ps_text name="data_note">サーバーに送るデータ: 標準の軸とボタン、続いて今のモードに応じた軸とボタン。</plus_ps_text>
				<panel name="data_panel">
					<plus_ps_box name="data_output_glass">
						<scroll_list name="data_output">
							<scroll_list.columns label="#" name="index"/>
							<scroll_list.columns label="名前" name="output"/>
							<scroll_list.columns label="値" name="value"/>
						</scroll_list>
					</plus_ps_box>
				</panel>
			</panel>
		</plus_ps_tabs>
	</plus_ps_box>
