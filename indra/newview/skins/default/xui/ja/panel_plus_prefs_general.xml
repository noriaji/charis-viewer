<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_general.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="general_panel" label="一般">
    <plus_ps_box name="ps_ground">
        <scroll_container name="general_scroll">
            <panel name="general_scroll_panel">
                <plus_ps_text name="language_textbox">
                    言語：
                </plus_ps_text>
                <plus_ps_combo name="language_combobox">
                    <plus_ps_combo.item name="English" label="English（英語）" />
                    <plus_ps_combo.item name="Danish" label="Dansk（デンマーク語）－ベータ" />
                    <plus_ps_combo.item name="Deutsch(German)" label="Deutsch（ドイツ語）－ベータ" />
                    <plus_ps_combo.item name="Spanish" label="Español（スペイン語）－ベータ" />
                    <plus_ps_combo.item name="French" label="Français（フランス語）－ベータ" />
                    <plus_ps_combo.item name="Italian" label="Italiano（イタリア語）－ベータ" />
                    <plus_ps_combo.item name="Polish" label="Polski（ポーランド語）－ベータ" />
                    <plus_ps_combo.item name="Portugese" label="Português（ポルトガル語）－ベータ" />
                    <plus_ps_combo.item name="Russian" label="Русский（ロシア語）－ベータ" />
                    <plus_ps_combo.item name="Turkish" label="Türkçe（トルコ語）－ベータ" />
                    <plus_ps_combo.item name="(Japanese)" label="日本語－ベータ" />
                    <plus_ps_combo.item name="Traditional Chinese" label="正體中文（繁体字中国語）－ベータ" />
                </plus_ps_combo>
                <plus_ps_text name="language_textbox2">
                    （再起動後に反映）
                </plus_ps_text>
                <plus_ps_text name="time_format_textbox">
                    時刻の表示：
                </plus_ps_text>
                <plus_ps_combo name="time_format_combobox">
                    <plus_ps_combo.item name="12H" label="午後1:00" />
                    <plus_ps_combo.item name="24H" label="13:00" />
                </plus_ps_combo>
                <plus_ps_text name="maturity_desired_prompt">
                    アクセスしたいコンテンツ：
                </plus_ps_text>
                <plus_ps_combo name="maturity_desired_combobox">
                    <plus_ps_combo.item name="Desired_Adult" label="General、Moderate、Adult" />
                    <plus_ps_combo.item name="Desired_Mature" label="GeneralとModerate" />
                    <plus_ps_combo.item name="Desired_PG" label="General" />
                </plus_ps_combo>
                <plus_ps_check_compat name="favorites_on_login_check" label="ログイン画面にお気に入りの場所を表示" />
                <plus_ps_text name="favorites_check_extra_text">
                    （このコンピューターを使う他の人にも表示されます）
                </plus_ps_text>
                <plus_ps_text name="name_tags_textbox">
                    名前の表示：
                </plus_ps_text>
                <plus_ps_radio name="Name_Tag_Preference">
                    <radio_item name="radio" label="オフ" />
                    <radio_item name="radio2" label="オン" />
                    <radio_item name="radio3" label="一時的に表示" />
                </plus_ps_radio>
                <plus_ps_check_compat name="show_my_name_checkbox1" label="自分の名前" />
                <plus_ps_check_compat name="show_slids" label="ユーザー名" tool_tip="bobsmith123 などユーザー名を表示" />
                <plus_ps_check_compat name="display_names_check" label="表示名を表示" tool_tip="これを選択すると、チャット、IMなどで表示名が表示されます。" />
                <plus_ps_check_compat name="show_friends" label="フレンドをハイライト表示" tool_tip="フレンドの名前をハイライト表示" />
                <plus_ps_combo name="group_title">
                    <plus_ps_combo.item name="no_tags" label="グループのタグを表示しない" />
                    <plus_ps_combo.item name="my_tag" label="自分のグループのタグだけ表示" />
                    <plus_ps_combo.item name="all_tags" label="すべてのグループのタグを表示" />
                </plus_ps_combo>
                <plus_ps_text name="inworld_typing_rg_label">
                    文字のキーを押した時：
                </plus_ps_text>
                <plus_ps_radio name="inworld_typing_preference">
                    <radio_item name="radio_start_chat" label="チャットを始める" />
                    <radio_item name="radio_move" label="移動する（WSADなど）" />
                </plus_ps_radio>
                <plus_ps_text name="title_afk_text">
                    「離席」とするまでの時間：
                </plus_ps_text>
                <plus_ps_combo name="afk" label="「離席」とするまでの時間：">
                    <plus_ps_combo.item name="item0" label="2分" />
                    <plus_ps_combo.item name="item1" label="5分" />
                    <plus_ps_combo.item name="item2" label="10分" />
                    <plus_ps_combo.item name="item3" label="30分" />
                    <plus_ps_combo.item name="item4" label="離席設定なし" />
                </plus_ps_combo>
                <plus_ps_text name="text_box3">
                    「着信拒否」時の応答：
                </plus_ps_text>
                <panel name="dnd_response_glass">
                    <text_editor name="do_not_disturb_response">
                        log_in_to_change
                    </text_editor>
                </panel>
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
