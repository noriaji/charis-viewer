			<string>その知らない人</string>
			<string>ある存在</string>
			<string>この存在</string>
			<string>その存在</string>
			<string>ある者</string>
			<string>この者</string>
			<string>その者</string>
			<string>ある魂</string>
			<string>この魂</string>
			<string>その魂</string>
			<string>だれか</string>
			<string>何人か</string>
