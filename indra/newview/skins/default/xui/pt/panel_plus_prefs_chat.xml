<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="chat" label="Chat">
	<plus_ps_box name="ps_ground">
		<scroll_container name="chat_scroll">
			<panel name="chat_scroll_panel">
				<panel name="general_chat_settings">
					<plus_ps_check_compat name="auto_complete_gestures" label="Auto completar os gestos em um bate-papo local" />
					<plus_ps_check_compat name="play_typing_animation" label="Executar animação de digitação durante o bate-papo" />
					<plus_ps_check_compat name="bubble_text_chat" label="Balão de conversa" />
					<plus_ps_text name="font_size">
						Tamanho da fonte:
					</plus_ps_text>
					<plus_ps_combo name="chat_font_size">
						<plus_ps_combo.item name="Small" label="Pequeno" />
						<plus_ps_combo.item name="Medium" label="Médio" />
						<plus_ps_combo.item name="Large" label="Grande" />
					</plus_ps_combo>
				</panel>
				<panel name="im_notification_settings">
					<plus_ps_check_compat name="voice_call_friends_only_check" label="Apenas amigos e grupos podem me ligar ou enviar MIs" />
					<plus_ps_text name="friend_ims">
						MIs de amigos:
					</plus_ps_text>
					<plus_ps_combo name="FriendIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Abrir janela Conversas" />
						<plus_ps_combo.item name="PopUpMessage" label="Abrir pop up com mensagem" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Piscar botão da barra de ferramentas" />
						<plus_ps_combo.item name="NoAction" label="Nenhuma ação" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_friend_im" label="Executar som" />
					<plus_ps_text name="non_friend_ims">
						MIs de não amigos:
					</plus_ps_text>
					<plus_ps_combo name="NonFriendIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Abrir janela Conversas" />
						<plus_ps_combo.item name="PopUpMessage" label="Abrir pop up com mensagem" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Piscar botão da barra de ferramentas" />
						<plus_ps_combo.item name="NoAction" label="Nenhuma ação" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_non_friend_im" label="Executar som" />
					<plus_ps_text name="conference_ims">
						MIs de conferências:
					</plus_ps_text>
					<plus_ps_combo name="ConferenceIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Abrir janela Conversas" />
						<plus_ps_combo.item name="PopUpMessage" label="Abrir pop up com mensagem" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Piscar botão da barra de ferramentas" />
						<plus_ps_combo.item name="NoAction" label="Nenhuma ação" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_conference_im" label="Executar som" />
					<plus_ps_text name="group_chat">
						Conversa em grupo:
					</plus_ps_text>
					<plus_ps_combo name="GroupChatOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Abrir janela Conversas" />
						<plus_ps_combo.item name="PopUpMessage" label="Abrir pop up com mensagem" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Piscar botão da barra de ferramentas" />
						<plus_ps_combo.item name="NoAction" label="Nenhuma ação" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_group_chat_im" label="Executar som" />
					<plus_ps_text name="nearby_chat">
						Conversa local:
					</plus_ps_text>
					<plus_ps_combo name="NearbyChatOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Abrir janela Conversas" />
						<plus_ps_combo.item name="PopUpMessage" label="Abrir pop up com mensagem" />
						<plus_ps_combo.item name="FlashToolBarButton" label="Piscar botão da barra de ferramentas" />
						<plus_ps_combo.item name="NoAction" label="Nenhuma ação" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_nearby_chat_im" label="Executar som" />
					<plus_ps_text name="object_ims">
						MIs de objetos:
					</plus_ps_text>
					<plus_ps_combo name="ObjectIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Abrir janela Conversas" />
						<plus_ps_combo.item name="PopUpMessage" label="Abrir pop up com mensagem" />
						<plus_ps_combo.item name="FlashToolBarButton" label="Piscar botão da barra de ferramentas" />
						<plus_ps_combo.item name="NoAction" label="Nenhuma ação" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_object_im" label="Executar som" />
					<plus_ps_text name="notifications_alert">
						Para interromper temporariamente todas as notificações, use Comunicar &gt; Não perturbe.
					</plus_ps_text>
				</panel>
				<panel name="play_sound_settings">
					<plus_ps_text name="play_sound">
						Executar som:
					</plus_ps_text>
					<plus_ps_check_compat name="new_conversation" label="Nova conversa" />
					<plus_ps_check_compat name="teleport_offer" label="Oferta de teletransporte" />
					<plus_ps_check_compat name="incoming_voice_call" label="Chamada de voz recebida" />
					<plus_ps_check_compat name="inventory_offer" label="Oferta de inventário" />
				</panel>
				<panel name="log_settings">
					<plus_ps_text name="logging_label">
						Salvar:
					</plus_ps_text>
					<plus_ps_combo name="conversation_log_combo">
						<plus_ps_combo.item name="log_and_transcripts" label="Log e transcrições" />
						<plus_ps_combo.item name="log_only" label="Apenas log" />
						<plus_ps_combo.item name="no_log_or_transcript" label="Sem log ou transcrição" />
					</plus_ps_combo>
					<plus_ps_button_compat name="clear_log" label="Limpar registro..." />
					<plus_ps_button_compat name="delete_transcripts" label="Excluir transcrições..." />
					<plus_ps_text name="log_location_label">
						Localização:
					</plus_ps_text>
					<plus_ps_button_compat name="log_path_button" label="Procurar..." label_selected="Procurar" />
				</panel>
				<plus_ps_button_compat name="ok_btn" label="Tradução..." />
				<plus_ps_button_compat name="autoreplace_showgui" label="Substituição automática..." />
				<plus_ps_button_compat name="spellcheck_showgui" label="Verificando a ortografia..." />
			</panel>
		</scroll_container>
	</plus_ps_box>
</panel>
