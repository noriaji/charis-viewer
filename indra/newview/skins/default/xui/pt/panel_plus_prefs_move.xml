<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_move.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="move_panel" label="Movimentar">
    <plus_ps_box name="ps_ground">
        <scroll_container name="move_scroll">
            <panel name="move_scroll_panel">
                <plus_ps_slider_compat name="camera_fov" label="Ângulo de visão" />
                <plus_ps_slider_compat name="camera_offset_scale" label="Distância" />
                <plus_ps_text name="heading2">
                    Posicionamento automático:
                </plus_ps_text>
                <plus_ps_check_compat name="edit_camera_movement" label="Construir/Editar" tool_tip="Use o posicionamento automático da câmera quando entrar e sair do modo de edição" />
                <plus_ps_check_compat name="appearance_camera_movement" label="Aparência" tool_tip="Use o posicionamento automático da câmera quando em modo de edição" />
                <plus_ps_text name="keyboard_lbl">
                    Teclado:
                </plus_ps_text>
                <plus_ps_check_compat name="arrow_keys_move_avatar_check" label="Teclas de seta sempre me movem" />
                <plus_ps_check_compat name="tap_tap_hold_to_run" label="Dê dois toques e pressione para correr" />
                <plus_ps_text name="mouse_lbl">
                    Mouse:
                </plus_ps_text>
                <plus_ps_check_compat name="first_person_avatar_visible" label="Mostre-me em visão de mouse" />
                <plus_ps_text name=" Mouse Sensitivity">
                    Sensibilidade do mouse:
                </plus_ps_text>
                <plus_ps_check_compat name="invert_mouse" label="Inverter" />
                <plus_ps_text name="single_click_action_lbl">
                    Clique único no terreno:
                </plus_ps_text>
                <plus_ps_combo name="single_click_action_combo">
                    <plus_ps_combo.item name="0" label="Nenhuma ação" />
                    <plus_ps_combo.item name="1" label="Mover para ponto clicado" />
                </plus_ps_combo>
                <plus_ps_text name="double_click_action_lbl">
                    Clique duplo no terreno:
                </plus_ps_text>
                <plus_ps_combo name="double_click_action_combo">
                    <plus_ps_combo.item name="0" label="Nenhuma ação" />
                    <plus_ps_combo.item name="1" label="Mover para ponto clicado" />
                    <plus_ps_combo.item name="2" label="Teletransportar para ponto clicado" />
                </plus_ps_combo>
                <plus_ps_button_compat name="joystick_setup_button" label="Outros dispositivos" />
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
