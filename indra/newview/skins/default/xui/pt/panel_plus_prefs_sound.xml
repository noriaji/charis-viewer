<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_sound.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="Preference Media panel" label="Sons">
    <panel.string name="middle_mouse">
        Botão do meio do mouse
    </panel.string>
    <plus_ps_box name="ps_ground">
        <scroll_container name="sound_scroll">
            <panel name="sound_scroll_panel">
                <plus_ps_slider_compat name="System Volume" label="Volume principal" />
                <plus_ps_slider_compat name="UI Volume" label="Botões" />
                <plus_ps_slider_compat name="Wind Volume" label="Ambiente" />
                <plus_ps_slider_compat name="SFX Volume" label="Efeitos sonoros" />
                <plus_ps_slider_compat name="Music Volume" label="Streaming de música" />
                <plus_ps_check_compat name="enable_music" label="Ativado" />
                <plus_ps_slider_compat name="Media Volume" label="Mídia" />
                <plus_ps_check_compat name="enable_media" label="Ativado" />
                <plus_ps_slider_compat name="Voice Volume" label="Bate-papo de voz" />
                <plus_ps_check_compat name="enable_voice_check" label="Ativado" />
                <plus_ps_combo name="media_auto_play_combo">
                    <item name="autoplay_disabled" label="Não" />
                    <item name="autoplay_enabled" label="Sim" />
                    <item name="autoplay_ask" label="Perguntar" />
                </plus_ps_combo>
                <plus_ps_check_compat name="media_show_on_others_btn" label="Tocar mídia anexada em outros avatares" tool_tip="Desmarque esta opção para ocultar mídias anexadas em avatares por perto" />
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
