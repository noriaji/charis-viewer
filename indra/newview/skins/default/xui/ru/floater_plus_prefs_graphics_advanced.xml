<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The Charis window (research/267 gfxadv-ui) in this language: the words of floater_preferences_graphics_advanced.xml, by name (the chain of names of en). -->
<floater name="prefs_graphics_advanced" title="ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ГРАФИКИ">
	<plus_ps_tabs name="graphics_tabs">
		<panel label="Общее" name="General">
			<scroll_container name="general_scroll">
				<panel name="general_scroll_panel">
					<plus_ps_text name="ShadersText">
						Шейдеры
					</plus_ps_text>
					<plus_ps_check_compat initial_value="true" label="Прозрачность воды" name="TransparentWater"/>
					<plus_ps_check_compat initial_value="true" label="Объемный свет" name="UseSSAO"/>
					<plus_ps_text name="RenderShadowDetailText">
						Тени:
					</plus_ps_text>
					<plus_ps_combo name="ShadowDetail">
						<plus_ps_combo.item label="Нет" name="0"/>
						<plus_ps_combo.item label="Солнце/луна" name="1"/>
						<plus_ps_combo.item label="Солнце/луна + осветители" name="2"/>
					</plus_ps_combo>
					<plus_ps_slider_compat label="Дальность отрисовки:" name="DrawDistance"/>
					<plus_ps_text name="DrawDistanceMeterText2">
						м
					</plus_ps_text>
					<plus_ps_slider_compat label="Макс. количество частиц:" name="MaxParticleCount"/>
					<plus_ps_text name="AvatarText">
						Аватар
					</plus_ps_text>
					<plus_ps_slider_compat label="Максимальная сложность:" name="IndirectMaxComplexity" tool_tip="Указывает расстояние, начиная с которого визуально сложный аватар рисуется как мармеладный мишка"/>
					<plus_ps_text name="IndirectMaxComplexityText">
						0
					</plus_ps_text>
					<plus_ps_slider_compat label="Макс. кол-во объемных:" name="IndirectMaxNonImpostors"/>
					<plus_ps_text name="IndirectMaxNonImpostorsText">
						0
					</plus_ps_text>
					<plus_ps_slider_compat label="Физика:" name="AvatarPhysicsDetail"/>
					<plus_ps_text name="AvatarPhysicsDetailText">
						Низкая
					</plus_ps_text>
					<plus_ps_text name="MeshText">
						Уровень детализации (LOD)
					</plus_ps_text>
					<plus_ps_slider_compat label="Объекты:" name="ObjectMeshDetail"/>
					<plus_ps_text name="ObjectMeshDetailText">
						Низкая
					</plus_ps_text>
					<plus_ps_slider_compat label="Гибкие примитивы:" name="FlexibleMeshDetail"/>
					<plus_ps_text name="FlexibleMeshDetailText">
						Низкая
					</plus_ps_text>
					<plus_ps_slider_compat label="Деревья:" name="TreeMeshDetail"/>
					<plus_ps_text name="TreeMeshDetailText">
						Низкая
					</plus_ps_text>
					<plus_ps_slider_compat label="Аватары:" name="AvatarMeshDetail"/>
					<plus_ps_text name="AvatarMeshDetailText">
						Низкая
					</plus_ps_text>
					<plus_ps_slider_compat label="Земля:" name="TerrainMeshDetail"/>
					<plus_ps_text name="TerrainMeshDetailText">
						Низкая
					</plus_ps_text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Аппаратные установки" name="Hardware Settings">
			<scroll_container name="hardware_scroll">
				<panel name="hardware_scroll_panel">
					<plus_ps_check_compat initial_value="true" label="Разрешить сжатие текстур (требует перезагрузки)" name="texture compression" tool_tip="Сжатие текстур в видеопамяти, что позволяет загружать текстуры большего размера за счет некоторого падения качества цвета."/>
					<plus_ps_text name="antialiasing label">
						Сглаживание:
					</plus_ps_text>
					<plus_ps_combo label="Сглаживание" name="fsaa">
						<plus_ps_combo.item label="Выключено" name="FSAADisabled"/>
					</plus_ps_combo>
					<plus_ps_text name="antialiasing restart">
						(требуется перезапуск)
					</plus_ps_text>
					<plus_ps_check_compat initial_value="true" label="Активировать поддержку отображения HiDPI (требуется перезапуск)" name="use HiDPI" tool_tip="Активировать OpenGL для рисования с высоким разрешением."/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Прорисовка" name="Rendering">
			<scroll_container name="rendering_scroll">
				<panel name="rendering_scroll_panel">
					<plus_ps_text name="Texture Rendering">
						Прорисовка текстур
					</plus_ps_text>
					<plus_ps_text name="Miscellaneous Rendering">
						Разное
					</plus_ps_text>
					<plus_ps_slider_compat label="Качество постобработки:" name="RenderPostProcess"/>
					<plus_ps_text name="PostProcessText">
						Низкое
					</plus_ps_text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Глубина резкости (DoF)" name="DOF panel">
			<scroll_container name="dof_scroll">
				<panel name="dof_scroll_panel">
					<plus_ps_check_compat initial_value="true" label="Включить глубину резкости (Это размоет вид за исключением фокусировки камеры.)" name="UseDoF"/>
					<plus_ps_check_compat name="RenderDepthOfFieldInEditMode" label="Включить в режиме редактирования"/>
					<plus_ps_slider_compat name="CameraFNum" label="Номер фокуса камеры:" tool_tip="Номер фокуса камеры - значение для эффекта глубины резкости"/>
					<plus_ps_slider_compat name="CameraFocal" label="Фокусное расстояние (мм):" tool_tip="Фокусное расстояние камеры для эффекта глубины резкости (в миллиметрах)"/>
					<plus_ps_slider_compat name="Camera FOV" label="Угол зрения камеры (град.):" tool_tip="Вертикальный угол зрения камеры для эффекта глубины резкости (в градусах)"/>
					<plus_ps_slider_compat name="CameraFocusTrans" label="Время фокусировки:" tool_tip="Время изменения фокусировки с одного места на другое"/>
					<plus_ps_slider_compat name="CameraDoFResScale" label="Качество прорисовки:" tool_tip="Влияет на качество размытия и производительность прорисовки. (выше = лучше качество, ниже = лучше производительность)"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Charis" name="Charis panel">
			<scroll_container name="charis_scroll">
				<panel name="charis_scroll_panel">
				</panel>
			</scroll_container>
		</panel>
	</plus_ps_tabs>
	<plus_ps_button_compat label="Вернуть рекомендуемые настройки" name="Defaults" width="400"/>
	<plus_ps_button_compat label="OK" label_selected="OK" name="OK"/>
	<plus_ps_button_compat label="Отмена" label_selected="Отмена" name="Cancel"/>
	<check_box label="RenderAvatarMaxComplexity (Отрисовка аватара макс. сложности)" name="RenderAvatarMaxComplexity"/>
	<check_box label="RenderAvatarMaxNonImpostors (Отрисовка макс. кол-ва 3-D аватаров)" name="RenderAvatarMaxNonImpostors"/>
</floater>
