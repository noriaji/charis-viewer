<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="prefs_graphics_advanced" title="ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ГРАФИКИ">
	<!-- plus: gfx-tabs (research/238). The rows sit in the tabs of en, wrapped the same way
	     (tab_container / panel / scroll_container / panel), or the translation does not apply. -->
	<tab_container name="graphics_tabs">
		<panel label="Общее" name="General">
			<scroll_container name="general_scroll">
				<panel name="general_scroll_panel">
					<text name="ShadersText">
						Шейдеры
					</text>
					<check_box initial_value="true" label="Прозрачность воды" name="TransparentWater"/>
					<check_box initial_value="true" label="Объемный свет" name="UseSSAO"/>
					<text name="RenderShadowDetailText">
						Тени:
					</text>
					<combo_box name="ShadowDetail">
						<combo_box.item label="Нет" name="0"/>
						<combo_box.item label="Солнце/луна" name="1"/>
						<combo_box.item label="Солнце/луна + осветители" name="2"/>
					</combo_box>
					<slider label="Дальность отрисовки:" name="DrawDistance"/>
					<text name="DrawDistanceMeterText2">
						м
					</text>
					<slider label="Макс. количество частиц:" name="MaxParticleCount"/>
					<text name="AvatarText">
						Аватар
					</text>
					<slider label="Максимальная сложность:" name="IndirectMaxComplexity" tool_tip="Указывает расстояние, начиная с которого визуально сложный аватар рисуется как мармеладный мишка"/>
					<text name="IndirectMaxComplexityText">
						0
					</text>
					<slider label="Макс. кол-во объемных:" name="IndirectMaxNonImpostors"/>
					<text name="IndirectMaxNonImpostorsText">
						0
					</text>
					<slider label="Физика:" name="AvatarPhysicsDetail"/>
					<text name="AvatarPhysicsDetailText">
						Низкая
					</text>
					<text name="MeshText">
						Уровень детализации (LOD)
					</text>
					<slider label="Объекты:" name="ObjectMeshDetail"/>
					<text name="ObjectMeshDetailText">
						Низкая
					</text>
					<slider label="Гибкие примитивы:" name="FlexibleMeshDetail"/>
					<text name="FlexibleMeshDetailText">
						Низкая
					</text>
					<slider label="Деревья:" name="TreeMeshDetail"/>
					<text name="TreeMeshDetailText">
						Низкая
					</text>
					<slider label="Аватары:" name="AvatarMeshDetail"/>
					<text name="AvatarMeshDetailText">
						Низкая
					</text>
					<slider label="Земля:" name="TerrainMeshDetail"/>
					<text name="TerrainMeshDetailText">
						Низкая
					</text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Аппаратные установки" name="Hardware Settings">
			<scroll_container name="hardware_scroll">
				<panel name="hardware_scroll_panel">
					<check_box initial_value="true" label="Разрешить сжатие текстур (требует перезагрузки)" name="texture compression" tool_tip="Сжатие текстур в видеопамяти, что позволяет загружать текстуры большего размера за счет некоторого падения качества цвета."/>
					<text name="antialiasing label">
						Сглаживание:
					</text>
					<combo_box label="Сглаживание" name="fsaa">
						<combo_box.item label="Выключено" name="FSAADisabled"/>
					</combo_box>
					<text name="antialiasing restart">
						(требуется перезапуск)
					</text>
					<check_box initial_value="true" label="Активировать поддержку отображения HiDPI (требуется перезапуск)" name="use HiDPI" tool_tip="Активировать OpenGL для рисования с высоким разрешением."/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Прорисовка" name="Rendering">
			<scroll_container name="rendering_scroll">
				<panel name="rendering_scroll_panel">
					<text name="Texture Rendering">
						Прорисовка текстур
					</text>
					<text name="Miscellaneous Rendering">
						Разное
					</text>
					<slider label="Качество постобработки:" name="RenderPostProcess"/>
					<text name="PostProcessText">
						Низкое
					</text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Глубина резкости (DoF)" name="DOF panel">
			<scroll_container name="dof_scroll">
				<panel name="dof_scroll_panel">
					<check_box initial_value="true" label="Включить глубину резкости (Это размоет вид за исключением фокусировки камеры.)" name="UseDoF"/>
					<check_box name="RenderDepthOfFieldInEditMode" label="Включить в режиме редактирования"/>
					<slider name="CameraFNum" label="Номер фокуса камеры:" tool_tip="Номер фокуса камеры - значение для эффекта глубины резкости"/>
					<slider name="CameraFocal" label="Фокусное расстояние (мм):" tool_tip="Фокусное расстояние камеры для эффекта глубины резкости (в миллиметрах)"/>
					<slider name="Camera FOV" label="Угол зрения камеры (град.):" tool_tip="Вертикальный угол зрения камеры для эффекта глубины резкости (в градусах)"/>
					<slider name="CameraFocusTrans" label="Время фокусировки:" tool_tip="Время изменения фокусировки с одного места на другое"/>
					<slider name="CameraDoFResScale" label="Качество прорисовки:" tool_tip="Влияет на качество размытия и производительность прорисовки. (выше = лучше качество, ниже = лучше производительность)"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Charis" name="Charis panel">
			<scroll_container name="charis_scroll">
				<panel name="charis_scroll_panel">
				</panel>
			</scroll_container>
		</panel>
	</tab_container>
	<!-- /plus -->
	<button label="Вернуть рекомендуемые настройки" name="Defaults"/>
	<button label="OK" label_selected="OK" name="OK"/>
	<button label="Отмена" label_selected="Отмена" name="Cancel"/>
	<check_box label="RenderAvatarMaxComplexity (Отрисовка аватара макс. сложности)" name="RenderAvatarMaxComplexity"/>
	<check_box label="RenderAvatarMaxNonImpostors (Отрисовка макс. кол-ва 3-D аватаров)" name="RenderAvatarMaxNonImpostors"/>
</floater>
