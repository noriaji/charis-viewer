<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="chat" label="Текстовый чат">
	<plus_ps_box name="ps_ground">
		<scroll_container name="chat_scroll">
			<panel name="chat_scroll_panel">
				<panel name="general_chat_settings">
					<plus_ps_check_compat name="auto_complete_gestures" label="Управление автоматическим завершением находится рядом с чатом" />
					<plus_ps_check_compat name="play_typing_animation" label="Воспроизводить анимацию ввода текста при общении" />
					<plus_ps_check_compat name="bubble_text_chat" label="Чат в пузырьках" />
					<plus_ps_text name="font_size">
						Размер шрифта:
					</plus_ps_text>
					<plus_ps_combo name="chat_font_size">
						<plus_ps_combo.item name="Small" label="Мелкий" />
						<plus_ps_combo.item name="Medium" label="Средний" />
						<plus_ps_combo.item name="Large" label="Крупный" />
					</plus_ps_combo>
				</panel>
				<panel name="im_notification_settings">
					<plus_ps_check_compat name="voice_call_friends_only_check" label="Только друзья и группы могут звонить мне и отправлять IM" />
					<plus_ps_text name="friend_ims">
						IM друзей:
					</plus_ps_text>
					<plus_ps_combo name="FriendIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Открыть окно разговоров" />
						<plus_ps_combo.item name="PopUpMessage" label="Сообщение во всплывающем окне" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Мигание кнопки на панели инструментов" />
						<plus_ps_combo.item name="NoAction" label="Без действия" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_friend_im" label="Звук" />
					<plus_ps_text name="non_friend_ims">
						IM чужих:
					</plus_ps_text>
					<plus_ps_combo name="NonFriendIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Открыть окно разговоров" />
						<plus_ps_combo.item name="PopUpMessage" label="Сообщение во всплывающем окне" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Мигание кнопки на панели инструментов" />
						<plus_ps_combo.item name="NoAction" label="Без действия" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_non_friend_im" label="Звук" />
					<plus_ps_text name="conference_ims">
						IM конференции:
					</plus_ps_text>
					<plus_ps_combo name="ConferenceIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Открыть окно разговоров" />
						<plus_ps_combo.item name="PopUpMessage" label="Сообщение во всплывающем окне" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Мигание кнопки на панели инструментов" />
						<plus_ps_combo.item name="NoAction" label="Без действия" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_conference_im" label="Звук" />
					<plus_ps_text name="group_chat">
						Групповой чат:
					</plus_ps_text>
					<plus_ps_combo name="GroupChatOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Открыть окно разговоров" />
						<plus_ps_combo.item name="PopUpMessage" label="Сообщение во всплывающем окне" />
						<plus_ps_combo.item name="FlashToolbarButton" label="Мигание кнопки на панели инструментов" />
						<plus_ps_combo.item name="NoAction" label="Без действия" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_group_chat_im" label="Звук" />
					<plus_ps_text name="nearby_chat">
						Локальный чат:
					</plus_ps_text>
					<plus_ps_combo name="NearbyChatOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Открыть окно разговоров" />
						<plus_ps_combo.item name="PopUpMessage" label="Сообщение во всплывающем окне" />
						<plus_ps_combo.item name="FlashToolBarButton" label="Мигание кнопки на панели инструментов" />
						<plus_ps_combo.item name="NoAction" label="Без действия" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_nearby_chat_im" label="Звук" />
					<plus_ps_text name="object_ims">
						IM объектов:
					</plus_ps_text>
					<plus_ps_combo name="ObjectIMOptions">
						<plus_ps_combo.item name="OpenConversationsWindow" label="Открыть окно разговоров" />
						<plus_ps_combo.item name="PopUpMessage" label="Сообщение во всплывающем окне" />
						<plus_ps_combo.item name="FlashToolBarButton" label="Мигание кнопки на панели инструментов" />
						<plus_ps_combo.item name="NoAction" label="Без действия" />
					</plus_ps_combo>
					<plus_ps_check_compat name="play_sound_object_im" label="Звук" />
					<plus_ps_text name="notifications_alert">
						Для временного отключения всех уведомлений вызовите меню «Общение &gt; Не беспокоить».
					</plus_ps_text>
				</panel>
				<panel name="play_sound_settings">
					<plus_ps_text name="play_sound">
						Звук:
					</plus_ps_text>
					<plus_ps_check_compat name="new_conversation" label="Новый разговор" />
					<plus_ps_check_compat name="teleport_offer" label="Предложение телепортации" />
					<plus_ps_check_compat name="incoming_voice_call" label="Входящий голосовой вызов" />
					<plus_ps_check_compat name="inventory_offer" label="Предложение инвентаря" />
				</panel>
				<panel name="log_settings">
					<plus_ps_text name="logging_label">
						Сохранять:
					</plus_ps_text>
					<plus_ps_combo name="conversation_log_combo">
						<plus_ps_combo.item name="log_and_transcripts" label="Журнал и записи" />
						<plus_ps_combo.item name="log_only" label="Только журнал" />
						<plus_ps_combo.item name="no_log_or_transcript" label="Ни журнал, ни записи" />
					</plus_ps_combo>
					<plus_ps_button_compat name="clear_log" label="Очистить журнал..." />
					<plus_ps_button_compat name="delete_transcripts" label="Удалить записи..." />
					<plus_ps_text name="log_location_label">
						Место:
					</plus_ps_text>
					<plus_ps_button_compat name="log_path_button" label="Обзор..." label_selected="Обзор" />
				</panel>
				<plus_ps_button_compat name="ok_btn" label="Перевод..." />
				<plus_ps_button_compat name="autoreplace_showgui" label="Автозамена..." />
				<plus_ps_button_compat name="spellcheck_showgui" label="Проверка правописания..." />
			</panel>
		</scroll_container>
	</plus_ps_box>
</panel>
