<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Charis window: the words of panel_plus_prefs_move.xml (en), by the same names (from the official
     panel's translation). -->
<panel name="move_panel" label="Перемещение">
    <plus_ps_box name="ps_ground">
        <scroll_container name="move_scroll">
            <panel name="move_scroll_panel">
                <plus_ps_slider_compat name="camera_fov" label="Угол обзора" />
                <plus_ps_slider_compat name="camera_offset_scale" label="Расстояние" />
                <plus_ps_text name="heading2">
                    Автоматическая установка позиции для:
                </plus_ps_text>
                <plus_ps_check_compat name="edit_camera_movement" label="создания/редактирования" tool_tip="Автоматическое позиционирование камеры при входе в режим редактирования и выходе из него" />
                <plus_ps_check_compat name="appearance_camera_movement" label="внешности" tool_tip="Автоматическое позиционирование камеры в режиме редактирования" />
                <plus_ps_text name="keyboard_lbl">
                    Клавиатура:
                </plus_ps_text>
                <plus_ps_check_compat name="arrow_keys_move_avatar_check" label="Клавиши со стрелками всегда перемещают меня" />
                <plus_ps_check_compat name="tap_tap_hold_to_run" label="Бег после двойного нажатия клавиши" />
                <plus_ps_text name="mouse_lbl">
                    Мышь:
                </plus_ps_text>
                <plus_ps_check_compat name="first_person_avatar_visible" label="Показывать меня при обзоре мышью" />
                <plus_ps_text name=" Mouse Sensitivity">
                    Чувствительность мыши:
                </plus_ps_text>
                <plus_ps_check_compat name="invert_mouse" label="Инвертировать" />
                <plus_ps_text name="single_click_action_lbl">
                    Один щелчок на земле:
                </plus_ps_text>
                <plus_ps_combo name="single_click_action_combo">
                    <plus_ps_combo.item name="0" label="Без действия" />
                    <plus_ps_combo.item name="1" label="Перемещение в точку щелчка" />
                </plus_ps_combo>
                <plus_ps_text name="double_click_action_lbl">
                    Двойной щелчок на земле:
                </plus_ps_text>
                <plus_ps_combo name="double_click_action_combo">
                    <plus_ps_combo.item name="0" label="Без действия" />
                    <plus_ps_combo.item name="1" label="Перемещение в точку щелчка" />
                    <plus_ps_combo.item name="2" label="Телепортация в точку щелчка" />
                </plus_ps_combo>
                <plus_ps_button_compat name="joystick_setup_button" label="Другие устройства" />
            </panel>
        </scroll_container>
    </plus_ps_box>
</panel>
