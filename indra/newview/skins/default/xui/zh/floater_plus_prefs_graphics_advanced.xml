<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The Charis window (research/267 gfxadv-ui) in this language: the words of floater_preferences_graphics_advanced.xml, by name (the chain of names of en). -->
<floater name="prefs_graphics_advanced" title="進階顯像偏好設定">
	<plus_ps_tabs name="graphics_tabs">
		<panel label="通用" name="General">
			<scroll_container name="general_scroll">
				<panel name="general_scroll_panel">
					<plus_ps_text name="ShadersText">
						著色器
					</plus_ps_text>
					<plus_ps_check_compat initial_value="true" label="清澈透明的水" name="TransparentWater"/>
					<plus_ps_check_compat initial_value="true" label="環境光遮蔽" name="UseSSAO"/>
					<plus_ps_text name="RenderShadowDetailText">
						陰影：
					</plus_ps_text>
					<plus_ps_combo name="ShadowDetail">
						<plus_ps_combo.item label="無" name="0"/>
						<plus_ps_combo.item label="日 / 月" name="1"/>
						<plus_ps_combo.item label="日 / 月 + 投影物" name="2"/>
					</plus_ps_combo>
					<plus_ps_slider_compat label="描繪距離：" name="DrawDistance"/>
					<plus_ps_text name="DrawDistanceMeterText2">
						公尺
					</plus_ps_text>
					<plus_ps_slider_compat label="最大粒子效果數量：" name="MaxParticleCount"/>
					<plus_ps_text name="AvatarText">
						化身
					</plus_ps_text>
					<plus_ps_slider_compat label="最大複雜度：" name="IndirectMaxComplexity" tool_tip="控制在何時機下讓複雜化身呈像為「JellyDoll」"/>
					<plus_ps_text name="IndirectMaxComplexityText">
						0
					</plus_ps_text>
					<plus_ps_slider_compat label="非假冒化身數目上限：" name="IndirectMaxNonImpostors"/>
					<plus_ps_text name="IndirectMaxNonImpostorsText">
						0
					</plus_ps_text>
					<plus_ps_slider_compat label="身體物理：" name="AvatarPhysicsDetail"/>
					<plus_ps_text name="AvatarPhysicsDetailText">
						低
					</plus_ps_text>
					<plus_ps_text name="MeshText">
						細節層次 (LOD) 距離細節
					</plus_ps_text>
					<plus_ps_slider_compat label="物件：" name="ObjectMeshDetail"/>
					<plus_ps_text name="ObjectMeshDetailText">
						低
					</plus_ps_text>
					<plus_ps_slider_compat label="彈性幾何元件：" name="FlexibleMeshDetail"/>
					<plus_ps_text name="FlexibleMeshDetailText">
						低
					</plus_ps_text>
					<plus_ps_slider_compat label="樹木：" name="TreeMeshDetail"/>
					<plus_ps_text name="TreeMeshDetailText">
						低
					</plus_ps_text>
					<plus_ps_slider_compat label="化身:" name="AvatarMeshDetail"/>
					<plus_ps_text name="AvatarMeshDetailText">
						低
					</plus_ps_text>
					<plus_ps_slider_compat label="地形:" name="TerrainMeshDetail"/>
					<plus_ps_text name="TerrainMeshDetailText">
						低
					</plus_ps_text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="硬體設定" name="Hardware Settings">
			<scroll_container name="hardware_scroll">
				<panel name="hardware_scroll_panel">
					<plus_ps_check_compat initial_value="true" label="啟用材質壓縮（須重新啟動）" name="texture compression" tool_tip="在影片記憶體中壓縮材質，讓高解析度材質可以載入，但色彩品質稍差。"/>
					<plus_ps_text name="antialiasing label">
						消除鋸齒：
					</plus_ps_text>
					<plus_ps_combo label="消除鋸齒" name="fsaa">
						<plus_ps_combo.item label="已停用" name="FSAADisabled"/>
					</plus_ps_combo>
					<plus_ps_text name="antialiasing restart">
						（須重新啟動）
					</plus_ps_text>
					<plus_ps_check_compat initial_value="true" label="啟用HiDPI顯示支援（須重新啟動）" name="use HiDPI" tool_tip="啓用OpenGL高解析度繪圖。"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="彩現" name="Rendering">
			<scroll_container name="rendering_scroll">
				<panel name="rendering_scroll_panel">
					<plus_ps_text name="Texture Rendering">
						紋理彩現
					</plus_ps_text>
					<plus_ps_text name="Miscellaneous Rendering">
						雜項彩現
					</plus_ps_text>
					<plus_ps_slider_compat label="後處理品質：" name="RenderPostProcess"/>
					<plus_ps_text name="PostProcessText">
						低
					</plus_ps_text>
				</panel>
			</scroll_container>
		</panel>
		<panel label="景深" name="DOF panel">
			<scroll_container name="dof_scroll">
				<panel name="dof_scroll_panel">
					<plus_ps_check_compat initial_value="true" label="啟用景深 (除了相機的焦點外，使視圖模糊)" name="UseDoF"/>
					<plus_ps_check_compat name="RenderDepthOfFieldInEditMode" label="在編輯物件或地形時啟用"/>
					<plus_ps_slider_compat name="CameraFNum" label="光圈數：" tool_tip="相機光圈數用於景深效果"/>
					<plus_ps_slider_compat name="CameraFocal" label="焦距：" tool_tip="用於景深效果的相機焦距（以毫米為單位）"/>
					<plus_ps_slider_compat name="Camera FOV" label="視場角：" tool_tip="相機垂直視場角（以度為單位）"/>
					<plus_ps_slider_compat name="CameraFocusTrans" label="轉換動態性：" tool_tip="相機移動時修改景深效果所需的時間"/>
					<plus_ps_slider_compat name="CameraDoFResScale" label="模糊彩現品質：" tool_tip="定義模糊彩現的品質和彩現效能。（越高的值品質越好，效能越低）"/>
				</panel>
			</scroll_container>
		</panel>
		<panel label="Charis" name="Charis panel">
			<scroll_container name="charis_scroll">
				<panel name="charis_scroll_panel">
				</panel>
			</scroll_container>
		</panel>
	</plus_ps_tabs>
	<plus_ps_button_compat label="重設為我們建議的設定" name="Defaults"/>
	<plus_ps_button_compat label="確定" label_selected="確定" name="OK"/>
	<plus_ps_button_compat label="取消" label_selected="取消" name="Cancel"/>
	<check_box label="RenderAvatarMaxComplexity" name="RenderAvatarMaxComplexity"/>
	<check_box label="RenderAvatarMaxNonImpostors" name="RenderAvatarMaxNonImpostors"/>
</floater>
